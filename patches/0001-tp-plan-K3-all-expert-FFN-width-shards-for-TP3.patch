diff --git a/runtime/include/sparkinfer/tp/shard.h b/runtime/include/sparkinfer/tp/shard.h
index d26e93c..c94e126 100644
--- a/runtime/include/sparkinfer/tp/shard.h
+++ b/runtime/include/sparkinfer/tp/shard.h
@@ -57,6 +57,18 @@ struct Band {
     bool operator==(const Band& o) const { return offset == o.offset && extent == o.extent; }
 };
 
+// How routed-expert weights are partitioned. Keep this explicit: the legacy
+// `experts_sharded` boolean can distinguish whole-expert sharding from "not
+// whole-expert", but it cannot say which matrix axis the fallback must split.
+// Treating all three expert matrices as a column shard is wrong: gate/up split
+// their OUTPUT (ne1), while down splits its INPUT (ne0).
+enum class MoeShardMode {
+    None,                  // no routed MoE, or TP=1 identity
+    WholeExperts,          // disjoint expert identities, full FFN width
+    AllExpertsFfnWidth,    // all identities on every rank, disjoint FFN bands
+    ExpertFfn2D,           // disjoint expert groups x disjoint FFN bands
+};
+
 // Split `total` into `tp_size` bands and return rank `rank`'s.
 //
 // Requires exact divisibility. A ragged split is representable but poisonous for
@@ -97,6 +109,7 @@ struct ShardDims {
     int moe_ffn_total = 0;
     int moe_ffn = 0;              // per-expert intermediate width, if ffn-sharded
     bool experts_sharded = false; // false => experts replicated, ffn sharded instead
+    MoeShardMode moe_shard_mode = MoeShardMode::None;
 
     // ---- 2-D MoE: expert groups x FFN band --------------------------------
     //
@@ -190,6 +203,19 @@ ShardError shard_dims(const ModelShape& shape, const Config& cfg, int rank,
 ShardError moe_2d_dims(int n_experts, int moe_ffn, int tp_size, int rank,
                        int expert_groups, int block_elems, ShardDims* d);
 
+// Explicit all-expert / FFN-width mode, used when the expert count does not divide
+// the TP size (K3: 896 experts over TP3). Every rank keeps every expert identity,
+// but owns a disjoint band of the intermediate width:
+//
+//   gate/up [latent, ffn, experts] split ne1 (output rows)
+//   down    [ffn, latent, experts] split ne0 (contracted input columns)
+//
+// `block_elems` is mandatory because down's ne0 is quant-blocked. The helper fails
+// before mutating `d` unless every rank gets an equal, block-aligned band. It only
+// plans metadata; loader/executor/kernel support remains a separate integration.
+ShardError moe_all_expert_width_dims(int n_experts, int moe_ffn, int tp_size, int rank,
+                                     int block_elems, ShardDims* d);
+
 // The expert-group count to use when nobody asked for one.
 //
 // TWO GROUPS, NOT MORE, AND ONLY ONCE THERE ARE RANKS TO SPARE. The two costs move in
diff --git a/runtime/src/tp/shard.cpp b/runtime/src/tp/shard.cpp
index e82d7ba..53ba7c9 100644
--- a/runtime/src/tp/shard.cpp
+++ b/runtime/src/tp/shard.cpp
@@ -74,6 +74,7 @@ ShardError moe_2d_dims(int n_experts, int moe_ffn, int tp_size, int rank,
     }
 
     d->moe_2d = true;
+    d->moe_shard_mode = MoeShardMode::ExpertFfn2D;
     d->moe_expert_groups = expert_groups;
     d->moe_ffn_shards = fs;
     d->expert_band = even_band(n_experts, expert_groups, rank / fs);
@@ -86,6 +87,52 @@ ShardError moe_2d_dims(int n_experts, int moe_ffn, int tp_size, int rank,
     return ShardError{};
 }
 
+ShardError moe_all_expert_width_dims(int n_experts, int moe_ffn, int tp_size, int rank,
+                                     int block_elems, ShardDims* d) {
+    if (!d) return ShardError{"moe_all_expert_width_dims: null out"};
+    if (tp_size <= 1)
+        return ShardError{"moe_all_expert_width_dims: tp_size must be >= 2"};
+    if (rank < 0 || rank >= tp_size)
+        return ShardError{"moe_all_expert_width_dims: rank out of range"};
+    if (n_experts <= 0)
+        return ShardError{"moe_all_expert_width_dims: n_experts must be > 0"};
+    if (moe_ffn <= 0)
+        return ShardError{"moe_all_expert_width_dims: moe_ffn must be > 0"};
+    if (block_elems <= 0)
+        return ShardError{"moe_all_expert_width_dims: block_elems must be > 0"};
+    if (!divisible(moe_ffn, tp_size)) {
+        std::ostringstream os;
+        os << "moe_ffn=" << moe_ffn << " not divisible by tp_size=" << tp_size;
+        return ShardError{os.str()};
+    }
+    const int rank_ffn = moe_ffn / tp_size;
+    if ((rank_ffn % block_elems) != 0) {
+        std::ostringstream os;
+        os << "ffn shard width " << rank_ffn << " is not a multiple of the "
+           << block_elems << "-element quant block";
+        return ShardError{os.str()};
+    }
+
+    // Validate everything before mutation. A caller can safely retain its prior
+    // whole-expert descriptor when this opt-in mode is unsupported.
+    ShardDims next = *d;
+    next.tp_size = tp_size;
+    next.rank = rank;
+    next.n_experts_total = n_experts;
+    next.n_experts = n_experts;
+    next.expert_band = Band{0, n_experts};
+    next.experts_sharded = false;
+    next.moe_shard_mode = MoeShardMode::AllExpertsFfnWidth;
+    next.moe_2d = false;
+    next.moe_expert_groups = 1;
+    next.moe_ffn_shards = tp_size;
+    next.moe_ffn_total = moe_ffn;
+    next.moe_ffn_band = even_band(moe_ffn, tp_size, rank);
+    next.moe_ffn = next.moe_ffn_band.extent;
+    *d = next;
+    return ShardError{};
+}
+
