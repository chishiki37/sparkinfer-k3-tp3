@@ -309,11 +325,18 @@ TensorResidency plan_tensor_residency(const std::string& name,
                 r.note  = "2-D MoE expects ne3=1 on a routed-expert tensor";
                 return r;
             }
+            if (d.moe_shard_mode == MoeShardMode::AllExpertsFfnWidth &&
+                (eb.offset != 0 || eb.extent != ne2)) {
+                r.error = ResidencyError::BadShape;
+                r.note = "all-expert FFN-width mode requires every expert identity";
