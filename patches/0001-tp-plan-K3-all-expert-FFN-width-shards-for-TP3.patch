                 p.experts = Band{0, d.n_experts_total};
-                if (!divisible(cols, d.tp_size)) {
+                p.band = d.moe_ffn_band;
+                p.rule = width_rule;
+                if (p.band.extent <= 0 || p.band.end() > d.moe_ffn_total) {
                     p.rule = Rule::Unknown;
-                    p.note = "expert ffn-width fallback but cols not divisible";
+                    p.note = "all-expert FFN-width mode has an invalid FFN band";
                     break;
                 }
-                p.band = even_band(cols, d.tp_size, d.rank);
-                p.cols = p.band.extent;
-                p.note = "experts not divisible by tp_size — ffn-width shard instead";
+                if (width_rule == Rule::ExpertRow2D) {
+                    if (rows != d.moe_ffn_total) {
+                        p.rule = Rule::Unknown;
+                        p.note = "gate/up output rows do not match moe_ffn_total";
+                        break;
+                    }
+                    p.rows = p.band.extent;
+                } else {
+                    if (cols != d.moe_ffn_total) {
+                        p.rule = Rule::Unknown;
+                        p.note = "down input cols do not match moe_ffn_total";
+                        break;
+                    }
+                    p.cols = p.band.extent;
+                }
+                p.note = "all experts present; FFN width sharded by matrix role";
+                break;
+            }
+            if (!d.experts_sharded) {
+                p.rule = Rule::Unknown;
+                p.note = "experts are not sharded but no explicit all-expert FFN-width mode is set";
                 break;
             }
             p.experts = d.expert_band;
