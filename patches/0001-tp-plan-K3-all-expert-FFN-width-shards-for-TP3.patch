 # The K3 decode schedule: op order, widths, and collective placement as DATA, so the
 # properties that would otherwise only show up as degraded output are assertable
 # without a GPU. Strongest check inside is the plan/manifest cross-check — two tensor
diff --git a/runtime/tests/tp3_all_expert_width_cpu_test.cpp b/runtime/tests/tp3_all_expert_width_cpu_test.cpp
new file mode 100644
index 0000000..0ecf3da
--- /dev/null
+++ b/runtime/tests/tp3_all_expert_width_cpu_test.cpp
@@ -0,0 +1,202 @@
+// CPU-only proof for K3 TP3 routed-expert width sharding.
+//
+// This does NOT claim that the CUDA loader, executor, or kernels can consume the
+// plan. It proves the part that must be right first: all 896 expert identities are
+// present on every rank, while the 1536 intermediate width is partitioned as three
+// block-aligned 512-wide bands. Gate/up split ne1; down splits ne0.
+
+#include "sparkinfer/gguf.h"
+#include "sparkinfer/tp/shard.h"
+#include "sparkinfer/tp/weight_residency.h"
+
+#include <cstdio>
+#include <string>
+
+using namespace sparkinfer;
+using namespace sparkinfer::tp;
+
+static int g_checks = 0;
+static int g_failures = 0;
+
+#define CHECK(cond, ...)                                                          \
+    do {                                                                          \
+        ++g_checks;                                                               \
+        if (!(cond)) {                                                            \
+            ++g_failures;                                                         \
+            std::printf("FAIL %s:%d: ", __FILE__, __LINE__);                    \
+            std::printf(__VA_ARGS__);                                             \
+            std::printf("\n");                                                   \
+        }                                                                         \
+    } while (0)
+
+#define CHECK_EQ(a, b) CHECK((a) == (b), "got %lld want %lld",                  \
+                             (long long)(a), (long long)(b))
+
+enum : int { TY_IQ1_S = 19, TY_UNKNOWN = 200 };
+
+static ShardDims tp3_dims(int rank) {
+    ShardDims d;
+    d.tp_size = 3;
+    d.rank = rank;
+    d.hidden = 7168;
+    const ShardError e = moe_all_expert_width_dims(
+        /*n_experts=*/896, /*moe_ffn=*/1536, /*tp_size=*/3, rank,
+        /*block_elems=*/256, &d);
+    CHECK(e.ok(), "rank %d plan failed: %s", rank, e.message.c_str());
+    return d;
+}
+
+static void test_exact_k3_tp3_geometry() {
+    std::printf("exact_k3_tp3_geometry\n");
+    int next = 0;
+    for (int rank = 0; rank < 3; ++rank) {
+        const ShardDims d = tp3_dims(rank);
+        CHECK(d.moe_shard_mode == MoeShardMode::AllExpertsFfnWidth,
+              "rank %d mode is not AllExpertsFfnWidth", rank);
+        CHECK(!d.experts_sharded, "rank %d must not claim disjoint expert ids", rank);
+        CHECK_EQ(d.n_experts, 896);
+        CHECK_EQ(d.expert_band.offset, 0);
+        CHECK_EQ(d.expert_band.extent, 896);
+        CHECK_EQ(d.moe_ffn, 512);
+        CHECK_EQ(d.moe_ffn_band.offset, next);
+        CHECK_EQ(d.moe_ffn_band.extent, 512);
+        CHECK_EQ(d.moe_ffn_band.offset % 256, 0);
+        CHECK_EQ(d.moe_ffn_band.extent % 256, 0);
+        next = d.moe_ffn_band.end();
+    }
+    CHECK_EQ(next, 1536);
+}
+
+static void check_tensor(const char* name, const long ne[4], Rule want_rule,
+                         SplitAxis want_axis) {
+    std::size_t sum_rank_bytes = 0;
+    std::size_t full_bytes = 0;
+    int next = 0;
+    for (int rank = 0; rank < 3; ++rank) {
+        const ShardDims d = tp3_dims(rank);
+        const TensorResidency r = plan_tensor_residency(name, ne, 3, TY_IQ1_S, d);
+        CHECK(r.ok(), "%s rank %d: %s (%s)", name, rank,
+              residency_error_name(r.error), r.note.c_str());
+        if (!r.ok()) continue;
+        CHECK(r.rule == want_rule, "%s rank %d rule %s", name, rank,
+              rule_name(r.rule));
+        CHECK(r.split_axis == want_axis, "%s rank %d split axis %s", name, rank,
+              split_axis_name(r.split_axis));
+        CHECK_EQ(r.rank_ne[2], 896);
+        CHECK_EQ(r.band.offset, next);
+        CHECK_EQ(r.band.extent, 512);
+        CHECK_EQ(r.copy.total_bytes(), r.rank_bytes);
+        CHECK_EQ(r.rank_bytes * 3, r.full_bytes);
+
+        if (want_axis == SplitAxis::Ne1_Output) {
+            CHECK_EQ(r.rank_ne[0], 3584);
+            CHECK_EQ(r.rank_ne[1], 512);
+            CHECK_EQ(r.copy.n_rows, 896);
+            CHECK_EQ(r.copy.src_stride, r.full_bytes / 896);
+        } else {
+            CHECK_EQ(r.rank_ne[0], 512);
+            CHECK_EQ(r.rank_ne[1], 3584);
+            CHECK_EQ(r.block_band.offset, rank * 2);
+            CHECK_EQ(r.block_band.extent, 2);
+            CHECK_EQ(r.copy.n_rows, 3584L * 896L);
+        }
+        next = r.band.end();
+        sum_rank_bytes += r.rank_bytes;
+        full_bytes = r.full_bytes;
+    }
+    CHECK_EQ(next, 1536);
+    CHECK_EQ(sum_rank_bytes, full_bytes);
+}
+
+static void test_matrix_roles_and_conservation() {
+    std::printf("matrix_roles_and_conservation\n");
+    const long gate_up[4] = {3584, 1536, 896, 1};
+    const long down[4] = {1536, 3584, 896, 1};
+    check_tensor("blk.1.ffn_gate_exps.weight", gate_up, Rule::ExpertRow2D,
+                 SplitAxis::Ne1_Output);
+    check_tensor("blk.1.ffn_up_exps.weight", gate_up, Rule::ExpertRow2D,
+                 SplitAxis::Ne1_Output);
+    check_tensor("blk.1.ffn_down_exps.weight", down, Rule::ExpertCol2D,
+                 SplitAxis::Ne0_Input);
+}
+
+static void test_fail_closed_contract() {
+    std::printf("fail_closed_contract\n");
+    ShardDims keep;
+    keep.tp_size = 7;
+    keep.rank = 6;
+    keep.n_experts = 123;
+
+    ShardError e = moe_all_expert_width_dims(896, 1536, 4, 0, 256, &keep);
+    CHECK(!e.ok(), "1536/4=384 must fail 256-block alignment");
+    CHECK_EQ(keep.tp_size, 7);
+    CHECK_EQ(keep.n_experts, 123);
+
+    e = moe_all_expert_width_dims(896, 1600, 3, 0, 256, &keep);
+    CHECK(!e.ok(), "indivisible FFN width must fail");
+    e = moe_all_expert_width_dims(896, 1536, 3, 0, 0, &keep);
+    CHECK(!e.ok(), "unknown quant block size must fail");
+    e = moe_all_expert_width_dims(896, 1536, 3, 3, 256, &keep);
+    CHECK(!e.ok(), "out-of-range rank must fail");
+
+    const long gate_up[4] = {3584, 1536, 896, 1};
+    const long wrong_ffn[4] = {3584, 1280, 896, 1};
+    const long wrong_experts[4] = {3584, 1536, 895, 1};
+    const ShardDims d = tp3_dims(0);
+    TensorResidency r = plan_tensor_residency(
+        "blk.1.ffn_gate_exps.weight", gate_up, 3, TY_UNKNOWN, d);
+    CHECK(!r.ok() && r.error == ResidencyError::UnknownType,
+          "unsupported quant type must fail before byte planning");
+    r = plan_tensor_residency(
+        "blk.1.ffn_gate_exps.weight", wrong_ffn, 3, TY_IQ1_S, d);
+    CHECK(!r.ok() && r.error == ResidencyError::UnknownRule,
+          "a gate/up FFN shape mismatch must fail");
+    r = plan_tensor_residency(
+        "blk.1.ffn_gate_exps.weight", wrong_experts, 3, TY_IQ1_S, d);
+    CHECK(!r.ok() && r.error == ResidencyError::BadShape,
+          "missing expert identity must fail");
+
+    ShardDims ambiguous = d;
+    ambiguous.moe_shard_mode = MoeShardMode::None;
+    r = plan_tensor_residency(
+        "blk.1.ffn_gate_exps.weight", gate_up, 3, TY_IQ1_S, ambiguous);
+    CHECK(!r.ok() && r.error == ResidencyError::UnknownRule,
+          "legacy experts_sharded=false without an explicit mode must fail");
+}
+
+static void test_default_tp4_tp8_are_unchanged() {
+    std::printf("default_tp4_tp8_are_unchanged\n");
+    ModelShape s;
+    s.hidden = 7168;
+    s.n_q_heads = 96;
+    s.n_kv_heads = 1;
+    s.head_dim = 128;
+    s.vocab = 163840;
+    s.n_experts = 896;
+    s.moe_ffn = 1536;
+    for (int tp : {4, 8}) {
+        Config cfg;
+        cfg.tp_size = tp;
+        for (int rank = 0; rank < tp; ++rank) {
+            ShardDims d;
+            const ShardError e = shard_dims(s, cfg, rank, &d);
+            CHECK(e.ok(), "default tp%d rank %d failed: %s", tp, rank,
+                  e.message.c_str());
+            CHECK(d.moe_shard_mode == MoeShardMode::WholeExperts,
+                  "default tp%d must stay whole-expert", tp);
+            CHECK(d.experts_sharded, "default tp%d rank %d expert flag", tp, rank);
+            CHECK_EQ(d.n_experts, 896 / tp);
+            CHECK_EQ(d.moe_ffn, 1536);
+        }
+    }
+}
+
+int main() {
+    test_exact_k3_tp3_geometry();
+    test_matrix_roles_and_conservation();
+    test_fail_closed_contract();
+    test_default_tp4_tp8_are_unchanged();
+    std::printf("%s: %d checks, %d failures\n",
+                g_failures ? "FAIL" : "PASS", g_checks, g_failures);
+    return g_failures ? 1 : 0;
+}
