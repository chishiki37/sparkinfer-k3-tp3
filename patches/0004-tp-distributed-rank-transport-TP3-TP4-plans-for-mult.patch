diff --git a/runtime/include/sparkinfer/tp/rank_transport.h b/runtime/include/sparkinfer/tp/rank_transport.h
new file mode 100644
index 0000000..7292215
--- /dev/null
+++ b/runtime/include/sparkinfer/tp/rank_transport.h
@@ -0,0 +1,221 @@
+#pragma once
+// TCP control-plane adapter for one K3 TP rank per physical host.
+//
+// Drives the CUDA-free rank_protocol state machines over framed sockets.
+// Deliberately independent of NCCL/CUDA so three/four localhost processes can
+// prove bootstrap, token lockstep, Abort, and Finish before any GPU work lands.
+//
+// Contract highlights (must match docs/k3-tp3-distributed-rank-protocol.md):
+//   - reject declared payload outside 250..506 before body allocation
+//   - bind each live connection to exactly one configured global rank
+//   - reject spoofed in-band ranks and second connections for a bound rank
+//   - deadlines on connect / phase waits; sticky failure + Abort broadcast
+//   - dedicated receive path so Abort can land while a compute wait is blocked
+
+#include "sparkinfer/tp/rank_protocol.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace sparkinfer {
+namespace tp {
+namespace dist {
+
+struct TransportConfig {
+    // Coordinator listen address. Workers connect here.
+    std::string host = "127.0.0.1";
+    uint16_t port = 0;  // 0 => ephemeral; filled after bind when hosting
+    // Wall deadlines. Zero disables that particular deadline (tests only).
+    std::chrono::milliseconds connect_timeout{5000};
+    std::chrono::milliseconds recv_timeout{10000};
+    std::chrono::milliseconds phase_timeout{30000};
+    // Static rank binding for worker connections (configured peer map).
+    // peers[i] is the expected source address token for global rank i, or empty
+    // to accept any peer and bind solely by the first Hello (lab/localhost).
+    std::vector<std::string> peer_tokens;
+};
+
+// Blocking framed send/recv. Rejects oversize headers before body allocation.
+class FramedSocket {
+public:
+    FramedSocket() = default;
+    explicit FramedSocket(int fd);
+    FramedSocket(FramedSocket&& other) noexcept;
+    FramedSocket& operator=(FramedSocket&& other) noexcept;
+    ~FramedSocket();
+
+    FramedSocket(const FramedSocket&) = delete;
+    FramedSocket& operator=(const FramedSocket&) = delete;
+
+    bool valid() const { return fd_ >= 0; }
+    int fd() const { return fd_; }
+    void close();
+
+    bool set_recv_timeout(std::chrono::milliseconds timeout, std::string* error = nullptr);
+    bool set_send_timeout(std::chrono::milliseconds timeout, std::string* error = nullptr);
+
+    bool send_message(const Message& message, std::string* error = nullptr);
+    bool recv_message(Message* message, std::string* error = nullptr);
+
+private:
+    int fd_ = -1;
+    bool send_all(const std::uint8_t* data, std::size_t n, std::string* error);
+    bool recv_all(std::uint8_t* data, std::size_t n, std::string* error);
+};
+
+// Listen socket for the coordinator.
+class TcpListener {
+public:
+    TcpListener() = default;
+    ~TcpListener();
+    TcpListener(const TcpListener&) = delete;
+    TcpListener& operator=(const TcpListener&) = delete;
+
+    bool listen(const std::string& host, uint16_t port, std::string* error = nullptr);
+    uint16_t bound_port() const { return port_; }
+    // Accept one connection with optional timeout (0 = block forever).
+    bool accept(FramedSocket* out, std::chrono::milliseconds timeout,
+                std::string* peer_addr = nullptr, std::string* error = nullptr);
+    void close();
+
+private:
+    int fd_ = -1;
+    uint16_t port_ = 0;
+};
+
+bool tcp_connect(const std::string& host, uint16_t port,
+                 std::chrono::milliseconds timeout, FramedSocket* out,
+                 std::string* error = nullptr);
+
+// ----------------------------------------------------------------------------
+// High-level session runners
+// ----------------------------------------------------------------------------
+
+struct StepRecord {
+    std::uint64_t sequence = 0;
+    int token_id = -1;
+};
+
+// Rank 0: accept world_size-1 workers (or world_size peers including a loopback
+// self-socket when include_self_rank0 is true — production uses out-of-band
+// local RankSession without a self TCP link).
+//
+// Production layout: coordinator owns local RankSession for rank 0 in-process
+// and TCP links only to ranks 1..world-1.
+class CoordinatorTransport {
+public:
+    CoordinatorTransport(const RankSpec& cluster, TransportConfig cfg);
+    ~CoordinatorTransport();
+
+    // Bind/listen. Fills cfg_.port when ephemeral.
+    bool host(std::string* error = nullptr);
+    uint16_t port() const { return cfg_.port; }
+
+    // Accept workers, run Hello collection, install NCCL id (caller-supplied),
+    // wait NcclReady/LoadReady, then expose ready() for begin_step loops.
+    // nccl_id_provider is called once after all Hellos (typically ncclGetUniqueId
+    // or a deterministic test id).
+    bool bootstrap(const std::function<bool(NcclUniqueId*, std::string*)>& nccl_id_provider,
+                   std::string* error = nullptr);
+
+    bool ready() const;
+    CoordinatorState state() const;
+
+    bool begin_step(int token_id, std::string* error = nullptr);
+    bool finish(std::string* error = nullptr);
+    bool fail(const std::string& detail, std::string* error = nullptr);
+
+    // Drain worker messages until state changes or timeout.
+    bool pump(std::chrono::milliseconds budget, std::string* error = nullptr);
+
+private:
+    RankSpec cluster_;
+    TransportConfig cfg_;
+    TcpListener listener_;
+    Coordinator coord_;
+    // sockets_[rank] for ranks 1..world-1; rank 0 is local and has no socket.
+    std::vector<std::unique_ptr<FramedSocket>> sockets_;
+    std::vector<std::uint64_t> conn_ids_;
+    std::mutex mu_;
+    std::atomic<bool> stop_{false};
+    std::thread rx_thread_;
+    std::string last_error_;
+
+    bool send_to_rank(int rank, const Message& m, std::string* error);
+    bool broadcast_except(int except_rank, const std::vector<Message>& msgs,
+                          std::string* error);
+    bool dispatch_outbound(const std::vector<Message>& msgs, std::string* error);
+    void rx_loop();
+    bool handle_inbound(int rank, const Message& m, std::string* error);
+};
+
+// Worker ranks 1..world-1 (or any non-coordinator rank).
+class RankTransport {
+public:
+    RankTransport(const RankSpec& spec, TransportConfig cfg);
+    ~RankTransport();
+
+    // Connect, Hello, wait NcclUniqueId, invoke on_nccl_init, report ready,
+    // wait BeginLoad, invoke on_load, report ready, then wait tokens.
+    bool bootstrap(const std::function<bool(const NcclUniqueId&, std::string*)>& on_nccl_init,
+                   const std::function<bool(std::string*)>& on_load,
+                   std::string* error = nullptr);
+
+    // Block until next Token, Finish, or Abort. Returns false on failure/finish.
+    // When true, *token_id is the synchronized input and the caller must run the
+    // local forward then call report_step_done.
+    bool wait_token(int* token_id, std::string* error = nullptr);
+    bool report_step_done(bool success, int status, const std::string& detail,
+                          std::string* error = nullptr);
+    bool wait_finished(std::string* error = nullptr);
+
+    RankState state() const;
+    bool good() const;
+
+private:
+    RankSpec spec_;
+    TransportConfig cfg_;
+    RankSession session_;
+    FramedSocket sock_;
+    std::mutex mu_;
+
+    bool send(const Message& m, std::string* error);
+    bool recv(Message* m, std::string* error);
+};
+
+// Convenience: spawn-free multi-rank dry run on localhost using threads + TCP.
+// Each rank runs in a thread; rank 0 samples a fixed token sequence.
+// Used by CPU tests; not a production multi-host launcher.
+struct LocalhostDryRunConfig {
+    int world_size = 3;  // 3 or 4
+    std::vector<int> tokens{1, 2, 3};
+    std::chrono::milliseconds timeouts{5000};
+    Digest model_digest{};
+    Digest plan_digest{};
+    std::uint64_t session_id = 1;
+    int vocab = 163840;
+};
+
+struct LocalhostDryRunResult {
+    bool ok = false;
+    std::string error;
+    std::vector<std::vector<int>> tokens_seen_per_rank;
+    CoordinatorState final_coord_state = CoordinatorState::Failed;
+};
+
+LocalhostDryRunResult run_localhost_protocol_dry_run(const LocalhostDryRunConfig& cfg);
+
+// Build canonical plan digest bytes for the audited TP3 / TP4 geometries.
+// Not a cryptographic signature — identity string hashed by the caller or tests.
+std::string plan_identity_string(int world_size);
+
+}  // namespace dist
+}  // namespace tp
+}  // namespace sparkinfer
diff --git a/runtime/src/tp/rank_collective.cpp b/runtime/src/tp/rank_collective.cpp
new file mode 100644
index 0000000..a731395
--- /dev/null
+++ b/runtime/src/tp/rank_collective.cpp
@@ -0,0 +1,294 @@
+// One-rank-per-process collectives: host mock + optional NCCL InitRank.
+
+#include "sparkinfer/tp/rank_collective.h"
+
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <sstream>
+#include <unordered_map>
+#include <vector>
+
+#if defined(SPARKINFER_TP_NCCL)
+#include <cuda_runtime.h>
+#include <nccl.h>
+static_assert(sizeof(ncclUniqueId) == sparkinfer::tp::dist::kNcclUniqueIdBytes,
+              "ncclUniqueId size must match dist::kNcclUniqueIdBytes (128)");
+#endif
+
+namespace sparkinfer {
+namespace tp {
+namespace dist {
+namespace {
+
+void set_err(std::string* error, const std::string& value) {
+    if (error) *error = value;
+}
+
+// ---- Host mock: process-local multi-thread shared slots --------------------
+// Good enough for unit tests in one process. Multi-process shm can be layered
+// later; production uses NCCL.
+
+struct HostMockRoom {
+    std::mutex mu;
+    std::condition_variable cv;
+    int world = 0;
+    int arrived = 0;
+    std::vector<float*> slots;  // non-owning pointers registered per reduce
+    std::size_t count = 0;
+    int generation = 0;
+};
+
+std::mutex g_rooms_mu;
+std::unordered_map<std::string, std::shared_ptr<HostMockRoom>> g_rooms;
+
+class HostMockRankCollective final : public RankCollective {
+public:
+    HostMockRankCollective(int world, int rank, std::shared_ptr<HostMockRoom> room)
+        : world_(world), rank_(rank), room_(std::move(room)) {}
+
+    int world_size() const override { return world_; }
+    int rank() const override { return rank_; }
+    bool supports_f32() const override { return true; }
+
+    bool allreduce_f32(void* buf, std::size_t count, RankStreamHandle) override {
+        if (!buf || aborted_) return false;
+        if (count == 0) return true;
+        auto* fbuf = static_cast<float*>(buf);
+        std::unique_lock<std::mutex> lock(room_->mu);
+        if (room_->arrived == 0) {
+            room_->slots.assign(static_cast<std::size_t>(world_), nullptr);
+            room_->count = count;
+        } else if (room_->count != count) {
+            return false;
+        }
+        room_->slots[static_cast<std::size_t>(rank_)] = fbuf;
+        ++room_->arrived;
+        if (room_->arrived < world_) {
+            const int gen = room_->generation;
+            room_->cv.wait(lock, [&] {
+                return room_->generation != gen || aborted_;
+            });
+            return !aborted_;
+        }
+        // Last arriver reduces, then releases waiters.
+        for (std::size_t i = 0; i < count; ++i) {
+            double acc = 0.0;
+            for (int r = 0; r < world_; ++r) {
+                acc += room_->slots[static_cast<std::size_t>(r)][i];
+            }
+            const float v = static_cast<float>(acc);
+            for (int r = 0; r < world_; ++r) {
+                room_->slots[static_cast<std::size_t>(r)][i] = v;
+            }
+        }
+        room_->arrived = 0;
+        ++room_->generation;
+        room_->cv.notify_all();
+        return true;
+    }
+
+    bool barrier(RankStreamHandle) override {
+        // Reuse allreduce of a single zero.
+        float z = 0.f;
+        return allreduce_f32(&z, 1, 0);
+    }
+
+    bool poll_async_error(std::string* error) override {
+        if (aborted_) {
+            set_err(error, "host mock aborted");
+            return false;
+        }
+        if (error) error->clear();
+        return true;
+    }
+
+    bool abort() override {
+        aborted_ = true;
+        {
+            std::lock_guard<std::mutex> lock(room_->mu);
+            ++room_->generation;  // wake waiters
+        }
+        room_->cv.notify_all();
+        return true;
+    }
+
+private:
+    int world_ = 0;
+    int rank_ = 0;
+    std::shared_ptr<HostMockRoom> room_;
+    bool aborted_ = false;
+};
+
+#if defined(SPARKINFER_TP_NCCL)
+class NcclRankCollective final : public RankCollective {
+public:
+    static std::unique_ptr<NcclRankCollective> create(int world, int rank, int local_device,
+                                                      const NcclUniqueId& id,
+                                                      std::string* error) {
+        auto self = std::unique_ptr<NcclRankCollective>(new NcclRankCollective());
+        self->world_ = world;
+        self->rank_ = rank;
+        self->device_ = local_device;
+        if (cudaSetDevice(local_device) != cudaSuccess) {
+            set_err(error, "cudaSetDevice failed");
+            return nullptr;
+        }
+        ncclUniqueId nccl_id;
+        static_assert(sizeof(nccl_id.internal) >= kNcclUniqueIdBytes ||
+                          sizeof(ncclUniqueId) == kNcclUniqueIdBytes,
+                      "nccl unique id layout");
+        std::memcpy(&nccl_id, id.data(), kNcclUniqueIdBytes);
+        ncclResult_t r = ncclCommInitRank(&self->comm_, world, nccl_id, rank);
+        if (r != ncclSuccess) {
+            std::ostringstream os;
+            os << "ncclCommInitRank: " << ncclGetErrorString(r);
+            set_err(error, os.str());
+            return nullptr;
+        }
+        return self;
+    }
+
+    ~NcclRankCollective() override {
+        if (comm_) {
+            ncclCommDestroy(comm_);
+            comm_ = nullptr;
+        }
+    }
+
+    int world_size() const override { return world_; }
+    int rank() const override { return rank_; }
+    bool supports_f32() const override { return true; }
+
+    bool allreduce_f32(void* buf, std::size_t count, RankStreamHandle stream) override {
+        if (!comm_ || !buf) return false;
+        if (count == 0) return true;
+        auto* cuda_stream = reinterpret_cast<cudaStream_t>(stream);
+        ncclResult_t r = ncclAllReduce(buf, buf, count, ncclFloat32, ncclSum, comm_, cuda_stream);
+        if (r != ncclSuccess) {
+            std::fprintf(stderr, "[dist] ncclAllReduce f32 rank %d: %s\n", rank_,
+                         ncclGetErrorString(r));
+            return false;
+        }
+        return true;
+    }
+
+    bool allreduce_bf16(void* buf, std::size_t count, RankStreamHandle stream) override {
+        if (!comm_ || !buf) return false;
+        if (count == 0) return true;
+        auto* cuda_stream = reinterpret_cast<cudaStream_t>(stream);
+        ncclResult_t r = ncclAllReduce(buf, buf, count, ncclBfloat16, ncclSum, comm_, cuda_stream);
+        return r == ncclSuccess;
+    }
+
+    bool barrier(RankStreamHandle stream) override {
+        float* dev = nullptr;
+        if (cudaMalloc(&dev, sizeof(float)) != cudaSuccess) return false;
+        float zero = 0.f;
+        cudaMemcpy(dev, &zero, sizeof(float), cudaMemcpyHostToDevice);
+        const bool ok = allreduce_f32(dev, 1, stream);
+        cudaFree(dev);
+        return ok;
+    }
+
+    bool poll_async_error(std::string* error) override {
+        if (!comm_) {
+            set_err(error, "no communicator");
+            return false;
+        }
+        ncclResult_t async_err = ncclSuccess;
+        ncclResult_t r = ncclCommGetAsyncError(comm_, &async_err);
+        if (r != ncclSuccess) {
+            set_err(error, ncclGetErrorString(r));
+            return false;
+        }
+        if (async_err != ncclSuccess) {
+            set_err(error, ncclGetErrorString(async_err));
+            return false;
+        }
+        if (error) error->clear();
+        return true;
+    }
+
+    bool abort() override {
+        if (!comm_) return true;
+        ncclCommAbort(comm_);
+        comm_ = nullptr;
+        return true;
+    }
+
+private:
+    NcclRankCollective() = default;
+    int world_ = 0;
+    int rank_ = 0;
+    int device_ = 0;
+    ncclComm_t comm_ = nullptr;
+};
+#endif
+
+}  // namespace
+
+bool make_nccl_unique_id_bytes(NcclUniqueId* out, std::string* error) {
+    if (!out) {
+        set_err(error, "null out");
+        return false;
+    }
+#if defined(SPARKINFER_TP_NCCL)
+    ncclUniqueId id;
+    ncclResult_t r = ncclGetUniqueId(&id);
+    if (r != ncclSuccess) {
+        set_err(error, ncclGetErrorString(r));
+        return false;
+    }
+    std::memcpy(out->data(), &id, kNcclUniqueIdBytes);
+    return true;
+#else
+    for (std::size_t i = 0; i < out->size(); ++i) {
+        (*out)[i] = static_cast<std::uint8_t>(0x5A ^ i);
+    }
+    if ((*out)[0] == 0) (*out)[0] = 1;
+    return true;
+#endif
+}
+
+std::unique_ptr<RankCollective> make_host_mock_rank_collective(
+    int world_size, int rank, const std::string& session_key, std::string* error) {
+    if (world_size < 2 || rank < 0 || rank >= world_size || session_key.empty()) {
+        set_err(error, "invalid host mock collective args");
+        return nullptr;
+    }
+    std::shared_ptr<HostMockRoom> room;
+    {
+        std::lock_guard<std::mutex> lock(g_rooms_mu);
+        auto& slot = g_rooms[session_key];
+        if (!slot) {
+            slot = std::make_shared<HostMockRoom>();
+            slot->world = world_size;
+        } else if (slot->world != world_size) {
+            set_err(error, "host mock world_size mismatch for session");
+            return nullptr;
+        }
+        room = slot;
+    }
+    return std::make_unique<HostMockRankCollective>(world_size, rank, std::move(room));
+}
+
+std::unique_ptr<RankCollective> make_nccl_rank_collective(
+    int world_size, int rank, int local_device, const NcclUniqueId& id, std::string* error) {
+#if defined(SPARKINFER_TP_NCCL)
+    return NcclRankCollective::create(world_size, rank, local_device, id, error);
+#else
+    (void)world_size;
+    (void)rank;
+    (void)local_device;
+    (void)id;
+    set_err(error, "SPARKINFER_TP_NCCL not enabled at build time");
+    return nullptr;
+#endif
+}
+
+}  // namespace dist
+}  // namespace tp
+}  // namespace sparkinfer
