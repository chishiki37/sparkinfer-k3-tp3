@@ -0,0 +1,78 @@
+#pragma once
+// One-rank-per-process collective API for distributed Spark TP.
+//
+// Distinct from Collective (single-process, vector-of-devices, ncclCommInitAll).
+// Do not overload that class: remote ranks have no local device pointers and
+// cannot join InitAll.
+//
+// This header stays free of NCCL includes so CPU CI can compile the type and a
+// host-memory mock. The NCCL implementation is selected at link/runtime when
+// SPARKINFER_TP_NCCL is defined.
+
+#include "sparkinfer/tp/rank_protocol.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace sparkinfer {
+namespace tp {
+namespace dist {
+
+// Opaque stream handle so the header stays CUDA-free. Callers cast to/from
+// cudaStream_t at the boundary (0 means the default stream / host mock).
+using RankStreamHandle = std::uintptr_t;
+
+class RankCollective {
+public:
+    virtual ~RankCollective() = default;
+
+    virtual int world_size() const = 0;
+    virtual int rank() const = 0;
+    virtual bool supports_f32() const = 0;
+
+    // In-place sum-reduce of `count` float32 elements in device (or host-mock)
+    // memory. False is fatal — partial reductions look like quality bugs.
+    virtual bool allreduce_f32(void* buf, std::size_t count,
+                               RankStreamHandle stream = 0) = 0;
+
+    // Optional bf16 path for non-K3 workloads; may return false if unsupported.
+    virtual bool allreduce_bf16(void* buf, std::size_t count,
+                                RankStreamHandle stream = 0) {
+        (void)buf;
+        (void)count;
+        (void)stream;
+        return false;
+    }
+
+    virtual bool barrier(RankStreamHandle stream = 0) = 0;
+
+    // Poll NCCL async errors (or mock fault injection). Empty string => healthy.
+    virtual bool poll_async_error(std::string* error = nullptr) = 0;
+
+    // Tear down hard. Required on Abort so peers do not hang in collectives.
+    virtual bool abort() = 0;
+};
+
+// Host-memory mock for multi-process CPU tests. Uses a shared POSIX shm +
+// pthread barrier keyed by session name. Not for production.
+std::unique_ptr<RankCollective> make_host_mock_rank_collective(
+    int world_size, int rank, const std::string& session_key, std::string* error);
+
+// Produce an opaque 128-byte id. With NCCL, wraps ncclGetUniqueId. Without NCCL,
+// fills a deterministic non-zero test pattern (still 128 bytes).
+bool make_nccl_unique_id_bytes(NcclUniqueId* out, std::string* error = nullptr);
+
+// Real NCCL rank communicator. Returns nullptr when SPARKINFER_TP_NCCL is off
+// or init fails. Requires CUDA device `local_device` visible in this process.
+std::unique_ptr<RankCollective> make_nccl_rank_collective(
+    int world_size, int rank, int local_device, const NcclUniqueId& id,
+    std::string* error);
+
+// static_assert bridge compiled only in the .cpp when NCCL headers are present:
+// sizeof(ncclUniqueId) == kNcclUniqueIdBytes.
+
+}  // namespace dist
+}  // namespace tp
+}  // namespace sparkinfer
