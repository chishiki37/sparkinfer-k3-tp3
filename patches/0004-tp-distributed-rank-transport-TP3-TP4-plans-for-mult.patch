+++ b/runtime/src/tp/rank_transport_tcp.cpp
@@ -0,0 +1,1143 @@
+// TCP framed transport for distributed K3 TP control plane.
+// Linux/POSIX sockets (DGX Spark / Ubuntu). Not built for native Win32 sockets.
+
+#include "sparkinfer/tp/rank_transport.h"
+
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstring>
+#include <sstream>
+#include <utility>
+
+namespace sparkinfer {
+namespace tp {
+namespace dist {
+namespace {
+
+void set_err(std::string* error, const std::string& value) {
+    if (error) *error = value;
+}
+
+std::string errno_str(const char* what) {
+    std::ostringstream os;
+    os << what << ": " << std::strerror(errno);
+    return os.str();
+}
+
+bool set_cloexec(int fd) {
+    const int flags = fcntl(fd, F_GETFD);
+    if (flags < 0) return false;
+    return fcntl(fd, F_SETFD, flags | FD_CLOEXEC) == 0;
+}
+
+bool set_timeouts(int fd, std::chrono::milliseconds timeout, std::string* error) {
+    if (timeout.count() <= 0) return true;
+    timeval tv{};
+    tv.tv_sec = static_cast<time_t>(timeout.count() / 1000);
+    tv.tv_usec = static_cast<suseconds_t>((timeout.count() % 1000) * 1000);
+    if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) != 0) {
+        set_err(error, errno_str("SO_RCVTIMEO"));
+        return false;
+    }
+    if (setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv)) != 0) {
+        set_err(error, errno_str("SO_SNDTIMEO"));
+        return false;
+    }
+    return true;
+}
+
+}  // namespace
+
+// ---- FramedSocket ----------------------------------------------------------
+
+FramedSocket::FramedSocket(int fd) : fd_(fd) {}
+
+FramedSocket::FramedSocket(FramedSocket&& other) noexcept : fd_(other.fd_) {
+    other.fd_ = -1;
+}
+
+FramedSocket& FramedSocket::operator=(FramedSocket&& other) noexcept {
+    if (this != &other) {
+        close();
+        fd_ = other.fd_;
+        other.fd_ = -1;
+    }
+    return *this;
+}
+
+FramedSocket::~FramedSocket() { close(); }
+
+void FramedSocket::close() {
+    if (fd_ >= 0) {
+        ::close(fd_);
+        fd_ = -1;
+    }
+}
+
+bool FramedSocket::set_recv_timeout(std::chrono::milliseconds timeout, std::string* error) {
+    if (fd_ < 0) {
+        set_err(error, "socket closed");
+        return false;
+    }
+    if (timeout.count() <= 0) return true;
+    timeval tv{};
+    tv.tv_sec = static_cast<time_t>(timeout.count() / 1000);
+    tv.tv_usec = static_cast<suseconds_t>((timeout.count() % 1000) * 1000);
+    if (setsockopt(fd_, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) != 0) {
+        set_err(error, errno_str("SO_RCVTIMEO"));
+        return false;
+    }
+    return true;
+}
+
+bool FramedSocket::set_send_timeout(std::chrono::milliseconds timeout, std::string* error) {
+    if (fd_ < 0) {
+        set_err(error, "socket closed");
+        return false;
+    }
+    if (timeout.count() <= 0) return true;
+    timeval tv{};
+    tv.tv_sec = static_cast<time_t>(timeout.count() / 1000);
+    tv.tv_usec = static_cast<suseconds_t>((timeout.count() % 1000) * 1000);
+    if (setsockopt(fd_, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv)) != 0) {
+        set_err(error, errno_str("SO_SNDTIMEO"));
+        return false;
+    }
+    return true;
+}
+
+bool FramedSocket::send_all(const std::uint8_t* data, std::size_t n, std::string* error) {
+    std::size_t off = 0;
+    while (off < n) {
+        const ssize_t w = ::send(fd_, data + off, n - off, MSG_NOSIGNAL);
+        if (w < 0) {
+            if (errno == EINTR) continue;
+            set_err(error, errno_str("send"));
+            return false;
+        }
+        if (w == 0) {
+            set_err(error, "send returned 0");
+            return false;
+        }
+        off += static_cast<std::size_t>(w);
+    }
+    return true;
+}
+
+bool FramedSocket::recv_all(std::uint8_t* data, std::size_t n, std::string* error) {
+    std::size_t off = 0;
+    while (off < n) {
+        const ssize_t r = ::recv(fd_, data + off, n - off, 0);
+        if (r < 0) {
+            if (errno == EINTR) continue;
+            set_err(error, errno_str("recv"));
+            return false;
+        }
+        if (r == 0) {
+            set_err(error, "peer closed connection");
+            return false;
+        }
+        off += static_cast<std::size_t>(r);
+    }
+    return true;
+}
+
+bool FramedSocket::send_message(const Message& message, std::string* error) {
+    if (fd_ < 0) {
+        set_err(error, "socket closed");
+        return false;
+    }
+    std::vector<std::uint8_t> frame;
+    if (!encode_message(message, &frame, error)) return false;
+    if (frame.size() > kMaxFrameBytes) {
+        set_err(error, "encoded frame exceeds kMaxFrameBytes");
+        return false;
+    }
+    return send_all(frame.data(), frame.size(), error);
+}
+
+bool FramedSocket::recv_message(Message* message, std::string* error) {
+    if (!message) {
+        set_err(error, "null message");
+        return false;
+    }
+    if (fd_ < 0) {
+        set_err(error, "socket closed");
+        return false;
+    }
+    std::uint8_t header[kWireHeaderBytes];
+    if (!recv_all(header, sizeof(header), error)) return false;
+
+    // Little-endian payload length at bytes 8..11 of the fixed header
+    // (magic u32, version u16, type u16, payload_len u32) — must match encoder.
+    const std::uint32_t payload_len =
+        static_cast<std::uint32_t>(header[8]) |
+        (static_cast<std::uint32_t>(header[9]) << 8) |
+        (static_cast<std::uint32_t>(header[10]) << 16) |
+        (static_cast<std::uint32_t>(header[11]) << 24);
+
+    if (payload_len < kWireFixedPayloadBytes || payload_len > kMaxPayloadBytes) {
+        set_err(error, "declared payload length outside 250..506 bound");
+        return false;
+    }
+    const std::size_t total = kWireHeaderBytes + static_cast<std::size_t>(payload_len);
+    if (total > kMaxFrameBytes) {
+        set_err(error, "declared frame exceeds kMaxFrameBytes");
+        return false;
+    }
+    std::vector<std::uint8_t> frame(total);
+    std::memcpy(frame.data(), header, kWireHeaderBytes);
+    if (!recv_all(frame.data() + kWireHeaderBytes, payload_len, error)) return false;
+    return decode_message(frame.data(), frame.size(), message, error);
+}
+
+// ---- TcpListener -----------------------------------------------------------
+
+TcpListener::~TcpListener() { close(); }
+
+void TcpListener::close() {
+    if (fd_ >= 0) {
+        ::close(fd_);
+        fd_ = -1;
+    }
+    port_ = 0;
+}
+
+bool TcpListener::listen(const std::string& host, uint16_t port, std::string* error) {
+    close();
+    fd_ = ::socket(AF_INET, SOCK_STREAM, 0);
+    if (fd_ < 0) {
+        set_err(error, errno_str("socket"));
+        return false;
+    }
+    set_cloexec(fd_);
+    int one = 1;
+    setsockopt(fd_, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port);
+    if (host.empty() || host == "0.0.0.0") {
+        addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    } else if (::inet_pton(AF_INET, host.c_str(), &addr.sin_addr) != 1) {
+        set_err(error, "invalid listen host (IPv4 only in this milestone)");
+        close();
+        return false;
+    }
+    if (::bind(fd_, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+        set_err(error, errno_str("bind"));
+        close();
+        return false;
+    }
+    if (::listen(fd_, 16) != 0) {
+        set_err(error, errno_str("listen"));
+        close();
+        return false;
+    }
+    sockaddr_in bound{};
+    socklen_t blen = sizeof(bound);
+    if (getsockname(fd_, reinterpret_cast<sockaddr*>(&bound), &blen) != 0) {
+        set_err(error, errno_str("getsockname"));
+        close();
+        return false;
+    }
+    port_ = ntohs(bound.sin_port);
+    return true;
+}
+
+bool TcpListener::accept(FramedSocket* out, std::chrono::milliseconds timeout,
+                         std::string* peer_addr, std::string* error) {
+    if (!out) {
+        set_err(error, "null out");
+        return false;
+    }
+    if (fd_ < 0) {
+        set_err(error, "listener closed");
+        return false;
+    }
+    if (timeout.count() > 0) {
+        pollfd pfd{};
+        pfd.fd = fd_;
+        pfd.events = POLLIN;
+        const int pr = ::poll(&pfd, 1, static_cast<int>(timeout.count()));
+        if (pr == 0) {
+            set_err(error, "accept timeout");
+            return false;
+        }
+        if (pr < 0) {
+            set_err(error, errno_str("poll"));
+            return false;
+        }
+    }
+    sockaddr_in peer{};
+    socklen_t plen = sizeof(peer);
+    const int cfd = ::accept(fd_, reinterpret_cast<sockaddr*>(&peer), &plen);
+    if (cfd < 0) {
+        set_err(error, errno_str("accept"));
+        return false;
+    }
+    set_cloexec(cfd);
+    int one = 1;
+    setsockopt(cfd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    if (peer_addr) {
+        char buf[INET_ADDRSTRLEN];
+        if (inet_ntop(AF_INET, &peer.sin_addr, buf, sizeof(buf))) {
+            *peer_addr = buf;
+        } else {
+            *peer_addr = "?";
+        }
+    }
+    *out = FramedSocket(cfd);
+    return true;
+}
+
+bool tcp_connect(const std::string& host, uint16_t port,
+                 std::chrono::milliseconds timeout, FramedSocket* out,
+                 std::string* error) {
+    if (!out) {
+        set_err(error, "null out");
+        return false;
+    }
+    const int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) {
+        set_err(error, errno_str("socket"));
+        return false;
+    }
+    set_cloexec(fd);
+    int one = 1;
+    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+
+    // Non-blocking connect with poll deadline.
+    const int flags = fcntl(fd, F_GETFL, 0);
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port);
+    if (::inet_pton(AF_INET, host.c_str(), &addr.sin_addr) != 1) {
+        set_err(error, "invalid connect host (IPv4 only)");
+        ::close(fd);
+        return false;
+    }
+    const int cr = ::connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr));
+    if (cr != 0 && errno != EINPROGRESS) {
+        set_err(error, errno_str("connect"));
+        ::close(fd);
+        return false;
+    }
+    if (cr != 0) {
+        pollfd pfd{};
+        pfd.fd = fd;
+        pfd.events = POLLOUT;
+        const int pr = ::poll(&pfd, 1, static_cast<int>(timeout.count() > 0 ? timeout.count() : -1));
+        if (pr == 0) {
+            set_err(error, "connect timeout");
+            ::close(fd);
+            return false;
+        }
+        if (pr < 0) {
+            set_err(error, errno_str("poll"));
+            ::close(fd);
+            return false;
+        }
+        int soerr = 0;
+        socklen_t sl = sizeof(soerr);
+        getsockopt(fd, SOL_SOCKET, SO_ERROR, &soerr, &sl);
+        if (soerr != 0) {
+            errno = soerr;
+            set_err(error, errno_str("connect"));
+            ::close(fd);
+            return false;
+        }
+    }
+    fcntl(fd, F_SETFL, flags);  // back to blocking
+    if (!set_timeouts(fd, timeout, error)) {
+        ::close(fd);
+        return false;
+    }
+    *out = FramedSocket(fd);
+    return true;
+}
+
+// ---- CoordinatorTransport --------------------------------------------------
+
+CoordinatorTransport::CoordinatorTransport(const RankSpec& cluster, TransportConfig cfg)
+    : cluster_(cluster), cfg_(std::move(cfg)), coord_(cluster_) {
+    sockets_.resize(static_cast<std::size_t>(cluster_.world_size));
+    conn_ids_.assign(static_cast<std::size_t>(cluster_.world_size), 0);
+}
+
+CoordinatorTransport::~CoordinatorTransport() {
+    stop_ = true;
+    if (rx_thread_.joinable()) rx_thread_.join();
+    listener_.close();
+    for (auto& s : sockets_) {
+        if (s) s->close();
+    }
+}
+
+bool CoordinatorTransport::host(std::string* error) {
+    if (!listener_.listen(cfg_.host, cfg_.port, error)) return false;
+    cfg_.port = listener_.bound_port();
+    return true;
+}
+
+bool CoordinatorTransport::send_to_rank(int rank, const Message& m, std::string* error) {
+    if (rank == cluster_.rank) {
+        // Local rank 0 never receives its own TCP control frames.
+        return true;
+    }
+    if (rank < 0 || rank >= cluster_.world_size || !sockets_[static_cast<std::size_t>(rank)]) {
+        set_err(error, "send_to_rank: no socket");
+        return false;
+    }
+    return sockets_[static_cast<std::size_t>(rank)]->send_message(m, error);
+}
+
+bool CoordinatorTransport::dispatch_outbound(const std::vector<Message>& msgs,
+                                             std::string* error) {
+    for (const Message& m : msgs) {
+        // Control messages target m.rank; broadcasts use rank field per protocol.
+        if (!send_to_rank(m.rank, m, error)) return false;
+    }
+    return true;
+}
+
+bool CoordinatorTransport::handle_inbound(int rank, const Message& m, std::string* error) {
+    std::vector<Message> outbound;
+    AuthenticatedPeer peer;
+    peer.rank = rank;
+    peer.connection_id = conn_ids_[static_cast<std::size_t>(rank)];
+    if (!coord_.accept(peer, m, &outbound, error)) {
+        std::vector<Message> abort_out;
+        coord_.fail(Phase::Bootstrap, 1, error ? *error : "accept failed", &abort_out, nullptr);
+        dispatch_outbound(abort_out, nullptr);
+        return false;
+    }
+    return dispatch_outbound(outbound, error);
+}
+
+void CoordinatorTransport::rx_loop() {
+    // Simple poller over worker sockets. Production may split control thread.
+    while (!stop_) {
+        std::vector<pollfd> pfds;
+        std::vector<int> ranks;
+        {
+            std::lock_guard<std::mutex> lock(mu_);
+            for (int r = 0; r < cluster_.world_size; ++r) {
+                if (r == cluster_.rank) continue;
+                auto& s = sockets_[static_cast<std::size_t>(r)];
+                if (!s || !s->valid()) continue;
+                pollfd p{};
+                p.fd = s->fd();
+                p.events = POLLIN;
+                pfds.push_back(p);
+                ranks.push_back(r);
+            }
+        }
+        if (pfds.empty()) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+            continue;
+        }
+        const int pr = ::poll(pfds.data(), pfds.size(), 50);
+        if (pr <= 0) continue;
+        for (std::size_t i = 0; i < pfds.size(); ++i) {
+            if (!(pfds[i].revents & (POLLIN | POLLHUP | POLLERR))) continue;
+            Message m;
+            std::string err;
+            bool ok = false;
+            {
+                std::lock_guard<std::mutex> lock(mu_);
+                ok = sockets_[static_cast<std::size_t>(ranks[i])]->recv_message(&m, &err);
+                if (ok) {
+                    if (!handle_inbound(ranks[i], m, &err)) {
+                        last_error_ = err;
+                        stop_ = true;
+                    }
+                } else {
+                    last_error_ = err;
+                    std::vector<Message> abort_out;
+                    coord_.fail(Phase::Step, 2, err, &abort_out, nullptr);
+                    dispatch_outbound(abort_out, nullptr);
+                    stop_ = true;
+                }
+            }
+        }
+    }
+}
+
+bool CoordinatorTransport::bootstrap(
+    const std::function<bool(NcclUniqueId*, std::string*)>& nccl_id_provider,
+    std::string* error) {
+    if (cluster_.rank != 0) {
+        set_err(error, "CoordinatorTransport requires cluster.rank==0");
+        return false;
+    }
+    // Accept world_size-1 workers.
+    const int need = cluster_.world_size - 1;
+    for (int i = 0; i < need; ++i) {
+        FramedSocket sock;
+        std::string peer;
+        if (!listener_.accept(&sock, cfg_.connect_timeout, &peer, error)) return false;
+        if (!sock.set_recv_timeout(cfg_.recv_timeout, error)) return false;
+        if (!sock.set_send_timeout(cfg_.recv_timeout, error)) return false;
+
+        // First message must be Hello; bind rank from authenticated/configured map.
+        Message hello;
+        if (!sock.recv_message(&hello, error)) return false;
+        if (hello.type != MessageType::Hello) {
+            set_err(error, "first frame must be Hello");
+            return false;
+        }
+        const int rank = hello.rank;
+        if (rank <= 0 || rank >= cluster_.world_size) {
+            set_err(error, "Hello rank out of worker range");
+            return false;
+        }
+        if (sockets_[static_cast<std::size_t>(rank)]) {
+            set_err(error, "duplicate Hello rank connection");
+            return false;
+        }
+        // Optional static token check.
+        if (rank < static_cast<int>(cfg_.peer_tokens.size()) &&
+            !cfg_.peer_tokens[static_cast<std::size_t>(rank)].empty() &&
+            cfg_.peer_tokens[static_cast<std::size_t>(rank)] != peer) {
+            set_err(error, "peer token/address mismatch for rank");
+            return false;
+        }
+        sockets_[static_cast<std::size_t>(rank)] = std::make_unique<FramedSocket>(std::move(sock));
+        conn_ids_[static_cast<std::size_t>(rank)] = static_cast<std::uint64_t>(rank) + 1000ULL;
+
+        std::vector<Message> outbound;
+        AuthenticatedPeer ap{rank, conn_ids_[static_cast<std::size_t>(rank)]};
+        if (!coord_.accept(ap, hello, &outbound, error)) return false;
+        if (!dispatch_outbound(outbound, error)) return false;
+    }
+
+    // Local rank 0 Hello into coordinator.
+    {
+        RankSession local(cluster_);
+        Message hello;
+        if (!local.hello(&hello, error)) return false;
+        std::vector<Message> outbound;
+        AuthenticatedPeer ap{0, 1};
+        conn_ids_[0] = 1;
+        if (!coord_.accept(ap, hello, &outbound, error)) return false;
+        if (!dispatch_outbound(outbound, error)) return false;
+    }
+
+    NcclUniqueId id{};
+    if (!nccl_id_provider || !nccl_id_provider(&id, error)) {
+        if (error && error->empty()) set_err(error, "nccl id provider failed");
+        return false;
+    }
+    {
+        std::vector<Message> outbound;
+        if (!coord_.install_nccl_unique_id(id, &outbound, error)) return false;
+        if (!dispatch_outbound(outbound, error)) return false;
+    }
+
+    // Rank 0 marks NCCL+load ready locally without TCP.
+    // Workers will reply over TCP; pump until Ready.
+    // Synthesize local NcclReady + LoadReady through a temporary RankSession path
+    // by feeding coordinator directly.
+    {
+        Message nccl_ready;
+        nccl_ready.type = MessageType::NcclReady;
+        nccl_ready.session_id = cluster_.session_id;
+        nccl_ready.rank = 0;
+        nccl_ready.world_size = cluster_.world_size;
+        nccl_ready.local_device = cluster_.local_device;
+        nccl_ready.n_experts = cluster_.n_experts;
+        nccl_ready.moe_ffn = cluster_.moe_ffn;
+        nccl_ready.expert_block_elems = cluster_.expert_block_elems;
+        nccl_ready.vocab = cluster_.vocab;
+        nccl_ready.model_digest = cluster_.model_digest;
+        nccl_ready.plan_digest = cluster_.plan_digest;
+        nccl_ready.phase = Phase::NcclInit;
+        nccl_ready.status = 0;
+        std::vector<Message> outbound;
+        AuthenticatedPeer ap{0, 1};
+        if (!coord_.accept(ap, nccl_ready, &outbound, error)) return false;
+        if (!dispatch_outbound(outbound, error)) return false;
+    }
+
+    // Receive worker NcclReady messages.
+    auto wait_state = [&](CoordinatorState want) -> bool {
+        const auto deadline = std::chrono::steady_clock::now() + cfg_.phase_timeout;
+        while (coord_.state() != want && coord_.good()) {
+            if (std::chrono::steady_clock::now() > deadline) {
+                set_err(error, "phase timeout waiting for workers");
+                return false;
+            }
+            // Poll each worker once.
+            for (int r = 1; r < cluster_.world_size; ++r) {
+                auto& s = sockets_[static_cast<std::size_t>(r)];
+                if (!s) continue;
+                pollfd pfd{};
+                pfd.fd = s->fd();
+                pfd.events = POLLIN;
+                if (::poll(&pfd, 1, 20) <= 0) continue;
+                Message m;
+                std::string err;
+                if (!s->recv_message(&m, &err)) {
+                    set_err(error, err);
+                    return false;
+                }
+                if (!handle_inbound(r, m, error)) return false;
+            }
+        }
+        return coord_.state() == want && coord_.good();
+    };
+
+    if (!wait_state(CoordinatorState::WaitingLoadReady) &&
+        coord_.state() != CoordinatorState::WaitingLoadReady) {
+        // After all NcclReady, state is WaitingLoadReady OR may already have BeginLoad outbound.
+        // install path: WaitingNcclReady -> after all ready, emits BeginLoad and WaitingLoadReady.
+        if (!coord_.good()) {
+            if (error && error->empty()) set_err(error, coord_.failure());
+            return false;
+        }
+    }
+    // Continue until Ready (all LoadReady).
+        {
+            const auto deadline = std::chrono::steady_clock::now() + cfg_.phase_timeout;
+            while (coord_.good() &&
+                   coord_.state() != CoordinatorState::Ready &&
+                   coord_.state() != CoordinatorState::Failed) {
+                if (std::chrono::steady_clock::now() > deadline) {
+                    set_err(error, "bootstrap phase timeout");
+                    return false;
+                }
+                for (int r = 1; r < cluster_.world_size; ++r) {
+                    auto& s = sockets_[static_cast<std::size_t>(r)];
+                    if (!s) continue;
+                    pollfd pfd{};
+                    pfd.fd = s->fd();
+                    pfd.events = POLLIN;
+                    if (::poll(&pfd, 1, 20) <= 0) continue;
+                    Message m;
+                    if (!s->recv_message(&m, error)) return false;
+                    if (!handle_inbound(r, m, error)) return false;
+                }
+                // Inject rank0 LoadReady when waiting for loads.
+                if (coord_.state() == CoordinatorState::WaitingLoadReady) {
+                    Message load_ready;
+                    load_ready.type = MessageType::LoadReady;
+                    load_ready.session_id = cluster_.session_id;
+                    load_ready.rank = 0;
+                    load_ready.world_size = cluster_.world_size;
+                    load_ready.local_device = cluster_.local_device;
+                    load_ready.n_experts = cluster_.n_experts;
+                    load_ready.moe_ffn = cluster_.moe_ffn;
+                    load_ready.expert_block_elems = cluster_.expert_block_elems;
+                    load_ready.vocab = cluster_.vocab;
+                    load_ready.model_digest = cluster_.model_digest;
+                    load_ready.plan_digest = cluster_.plan_digest;
+                    load_ready.phase = Phase::Load;
+                    load_ready.status = 0;
+                    std::vector<Message> outbound;
+                    AuthenticatedPeer ap{0, 1};
+                    std::string err;
+                    if (coord_.accept(ap, load_ready, &outbound, &err)) {
+                        if (!dispatch_outbound(outbound, error)) return false;
+                    }
+                }
+            }
+        }
+    if (coord_.state() != CoordinatorState::Ready) {
+        set_err(error, coord_.failure().empty() ? "bootstrap failed" : coord_.failure());
+        return false;
+    }
+    stop_ = false;
+    rx_thread_ = std::thread([this] { rx_loop(); });
+    return true;
+}
+
+bool CoordinatorTransport::ready() const {
+    return coord_.state() == CoordinatorState::Ready ||
+           coord_.state() == CoordinatorState::StepInFlight;
+}
+
+CoordinatorState CoordinatorTransport::state() const { return coord_.state(); }
+
+bool CoordinatorTransport::begin_step(int token_id, std::string* error) {
+    std::lock_guard<std::mutex> lock(mu_);
+    std::vector<Message> outbound;
+    if (!coord_.begin_step(token_id, &outbound, error)) return false;
+    return dispatch_outbound(outbound, error);
+}
+
+bool CoordinatorTransport::finish(std::string* error) {
+    std::lock_guard<std::mutex> lock(mu_);
+    std::vector<Message> outbound;
+    if (!coord_.finish(&outbound, error)) return false;
+    if (!dispatch_outbound(outbound, error)) return false;
+    // Wait finish acks via rx thread + pump.
+    const auto deadline = std::chrono::steady_clock::now() + cfg_.phase_timeout;
+    while (coord_.state() != CoordinatorState::Finished && coord_.good()) {
+        if (std::chrono::steady_clock::now() > deadline) {
+            set_err(error, "finish timeout");
+            return false;
+        }
+        // Rank-0 FinishAck is injected by the full distributed runtime once it
+        // owns a local RankSession; this transport milestone relies on workers
+        // plus the rx thread for remote acks.
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        if (!last_error_.empty()) {
+            set_err(error, last_error_);
+            return false;
+        }
+    }
+    stop_ = true;
+    return coord_.state() == CoordinatorState::Finished;
+}
+
+bool CoordinatorTransport::fail(const std::string& detail, std::string* error) {
+    std::lock_guard<std::mutex> lock(mu_);
+    std::vector<Message> outbound;
+    if (!coord_.fail(Phase::Step, 1, detail, &outbound, error)) return false;
+    return dispatch_outbound(outbound, error);
+}
+
+bool CoordinatorTransport::pump(std::chrono::milliseconds budget, std::string* error) {
+    const auto deadline = std::chrono::steady_clock::now() + budget;
+    while (std::chrono::steady_clock::now() < deadline) {
+        if (!last_error_.empty()) {
+            set_err(error, last_error_);
+            return false;
+        }
+        if (coord_.state() == CoordinatorState::Ready ||
+            coord_.state() == CoordinatorState::Finished) {
+            return true;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    return true;
+}
+
+// ---- RankTransport ---------------------------------------------------------
+
+RankTransport::RankTransport(const RankSpec& spec, TransportConfig cfg)
+    : spec_(spec), cfg_(std::move(cfg)), session_(spec_) {}
+
+RankTransport::~RankTransport() { sock_.close(); }
+
+bool RankTransport::send(const Message& m, std::string* error) {
+    return sock_.send_message(m, error);
+}
+
+bool RankTransport::recv(Message* m, std::string* error) {
+    return sock_.recv_message(m, error);
+}
+
+bool RankTransport::bootstrap(
+    const std::function<bool(const NcclUniqueId&, std::string*)>& on_nccl_init,
+    const std::function<bool(std::string*)>& on_load,
+    std::string* error) {
+    if (!tcp_connect(cfg_.host, cfg_.port, cfg_.connect_timeout, &sock_, error)) return false;
+    if (!sock_.set_recv_timeout(cfg_.recv_timeout, error)) return false;
+    if (!sock_.set_send_timeout(cfg_.recv_timeout, error)) return false;
+
+    Message hello;
+    if (!session_.hello(&hello, error)) return false;
+    if (!send(hello, error)) return false;
+
+    // NcclUniqueId
+    Message m;
+    if (!recv(&m, error)) return false;
+    if (!session_.accept_control(m, nullptr, error)) return false;
+    if (session_.state() != RankState::NeedNcclInit) {
+        set_err(error, "expected NeedNcclInit after unique id");
+        return false;
+    }
+    if (on_nccl_init) {
+        if (!on_nccl_init(session_.nccl_unique_id(), error)) {
+            Message out;
+            session_.report_nccl_ready(false, 1, error ? *error : "nccl init failed", &out, nullptr);
+            send(out, nullptr);
+            return false;
+        }
+    }
+    {
+        Message out;
+        if (!session_.report_nccl_ready(true, 0, "", &out, error)) return false;
+        if (!send(out, error)) return false;
+    }
+
+    // BeginLoad
+    if (!recv(&m, error)) return false;
+    if (!session_.accept_control(m, nullptr, error)) return false;
+    if (on_load) {
+        if (!on_load(error)) {
+            Message out;
+            session_.report_load_ready(false, 1, error ? *error : "load failed", &out, nullptr);
+            send(out, nullptr);
+            return false;
+        }
+    }
+    {
+        Message out;
+        if (!session_.report_load_ready(true, 0, "", &out, error)) return false;
+        if (!send(out, error)) return false;
+    }
+    return session_.state() == RankState::WaitingToken;
+}
+
+bool RankTransport::wait_token(int* token_id, std::string* error) {
+    Message m;
+    if (!recv(&m, error)) return false;
+    int tok = -1;
+    if (!session_.accept_control(m, &tok, error)) return false;
+    if (m.type == MessageType::Finish || m.type == MessageType::Abort) {
+        return false;
+    }
+    if (token_id) *token_id = tok;
+    return session_.state() == RankState::StepRunning;
+}
+
+bool RankTransport::report_step_done(bool success, int status, const std::string& detail,
+                                     std::string* error) {
+    Message out;
+    if (!session_.report_step_done(success, status, detail, &out, error)) return false;
+    return send(out, error);
+}
+
+bool RankTransport::wait_finished(std::string* error) {
+    // Drain until Finish/Abort then ack.
+    while (session_.good() && session_.state() != RankState::Finished &&
+           session_.state() != RankState::Failed) {
+        Message m;
+        if (!recv(&m, error)) return false;
+        int tok = -1;
+        if (!session_.accept_control(m, &tok, error)) {
+            if (session_.state() == RankState::Failed) return false;
+        }
+        if (session_.state() == RankState::FinishPending) {
+            Message out;
+            if (!session_.report_finish_ack(&out, error)) return false;
+            if (!send(out, error)) return false;
+            return session_.state() == RankState::Finished;
+        }
+        if (session_.state() == RankState::StepRunning) {
+            // Unexpected token while waiting finish — complete it.
+            Message out;
+            session_.report_step_done(true, 0, "", &out, nullptr);
+            send(out, nullptr);
+        }
+        if (m.type == MessageType::Abort) return false;
+    }
+    return session_.state() == RankState::Finished;
+}
+
+RankState RankTransport::state() const { return session_.state(); }
+bool RankTransport::good() const { return session_.good(); }
+
+// ---- Dry run ---------------------------------------------------------------
+
+std::string plan_identity_string(int world_size) {
+    std::ostringstream os;
+    os << "sparkinfer-k3-dist-v1 world=" << world_size
+       << " experts=896 moe_ffn=1536 block=256 WEPS=0";
+    if (world_size == 3) {
+        os << " mode=AllExpertsFfnWidth bands=512/512/512 gate_up=ne1 down=ne0";
+    } else if (world_size == 4) {
+        os << " mode=ExpertFfn2D eg=2 fs=2 experts_per_group=448 ffn_per_shard=768";
+    } else {
+        os << " mode=unsupported";
+    }
+    return os.str();
+}
+
+static Digest digest_from_string(const std::string& s) {
+    Digest d{};
+    for (std::size_t i = 0; i < s.size(); ++i) {
+        d[i % d.size()] ^= static_cast<std::uint8_t>(s[i]);
+        d[(i + 7) % d.size()] =
+            static_cast<std::uint8_t>(d[(i + 7) % d.size()] * 33u + static_cast<unsigned>(s[i]));
+    }
+    if (d[0] == 0) d[0] = 1;
+    return d;
+}
+
+static RankSpec make_spec(const LocalhostDryRunConfig& cfg, int rank) {
+    RankSpec s;
+    s.session_id = cfg.session_id;
+    s.world_size = cfg.world_size;
+    s.rank = rank;
+    s.local_device = 0;
+    s.n_experts = 896;
+    s.moe_ffn = 1536;
+    s.expert_block_elems = 256;
+    s.vocab = cfg.vocab;
+    s.model_digest = cfg.model_digest;
+    s.plan_digest = cfg.plan_digest;
+    if (s.model_digest[0] == 0 && s.model_digest[1] == 0)
+        s.model_digest = digest_from_string("model-test");
+    if (s.plan_digest[0] == 0 && s.plan_digest[1] == 0)
+        s.plan_digest = digest_from_string(plan_identity_string(cfg.world_size));
+    return s;
+}
+
+static AuthenticatedPeer peer_of(int rank) {
+    AuthenticatedPeer p;
+    p.rank = rank;
+    p.connection_id = 0xC0ffee00ULL + static_cast<std::uint64_t>(rank);
+    return p;
+}
+
+// In-process multi-rank protocol dry-run (no sockets). Exercises the same
+// Coordinator/RankSession machines the TCP adapter drives, for world 3 and 4.
+LocalhostDryRunResult run_localhost_protocol_dry_run(const LocalhostDryRunConfig& cfg) {
+    LocalhostDryRunResult result;
+    if (!supported_k3_dist_world_size(cfg.world_size)) {
+        result.error = "world_size must be 3 or 4";
+        return result;
+    }
+
+    const RankSpec cluster = make_spec(cfg, 0);
+    for (int r = 0; r < cfg.world_size; ++r) {
+        ShardDims dims;
+        const ShardError e = validate_rank_spec(make_spec(cfg, r), &dims);
+        if (!e.ok()) {
+            result.error = e.message;
+            return result;
+        }
+        if (cfg.world_size == 3) {
+            if (dims.moe_shard_mode != MoeShardMode::AllExpertsFfnWidth ||
+                dims.n_experts != 896 || dims.moe_ffn != 512) {
+                result.error = "TP3 geometry mismatch";
+                return result;
+            }
+            const int want_off = r * 512;
+            if (dims.moe_ffn_band.offset != want_off || dims.moe_ffn_band.extent != 512) {
+                result.error = "TP3 FFN band mismatch";
+                return result;
+            }
+        } else {
+            if (dims.moe_shard_mode != MoeShardMode::ExpertFfn2D ||
+                dims.moe_expert_groups != 2 || dims.moe_ffn_shards != 2 ||
+                dims.n_experts != 448 || dims.moe_ffn != 768) {
+                result.error = "TP4 geometry mismatch";
+                return result;
+            }
+        }
+    }
+
+    Coordinator coordinator(cluster);
+    std::vector<RankSession> ranks;
+    ranks.reserve(static_cast<std::size_t>(cfg.world_size));
+    for (int r = 0; r < cfg.world_size; ++r) ranks.emplace_back(make_spec(cfg, r));
+
+    auto wire = [](const Message& in, Message* out, std::string* err) -> bool {
+        std::vector<std::uint8_t> bytes;
+        if (!encode_message(in, &bytes, err)) return false;
+        return decode_message(bytes.data(), bytes.size(), out, err);
+    };
+
+    std::string error;
+    std::vector<Message> out;
+
+    // Hello
+    for (int r = 0; r < cfg.world_size; ++r) {
+        Message hello;
+        if (!ranks[static_cast<std::size_t>(r)].hello(&hello, &error)) {
+            result.error = error;
+            return result;
+        }
+        Message m;
+        if (!wire(hello, &m, &error)) {
+            result.error = error;
+            return result;
+        }
+        if (!coordinator.accept(peer_of(r), m, &out, &error)) {
+            result.error = error;
+            return result;
+        }
+    }
+    if (coordinator.state() != CoordinatorState::AwaitingNcclUniqueId) {
+        result.error = "expected AwaitingNcclUniqueId";
+        return result;
+    }
+
+    NcclUniqueId id{};
+    for (std::size_t i = 0; i < id.size(); ++i)
+        id[i] = static_cast<std::uint8_t>(0xA0 + i);
+    out.clear();
+    if (!coordinator.install_nccl_unique_id(id, &out, &error)) {
+        result.error = error;
+        return result;
+    }
+    for (const Message& control : out) {
+        Message m;
+        if (!wire(control, &m, &error)) {
+            result.error = error;
+            return result;
+        }
+        if (!ranks[static_cast<std::size_t>(m.rank)].accept_control(m, nullptr, &error)) {
+            result.error = error;
+            return result;
+        }
+    }
+
+    out.clear();
+    for (int r = 0; r < cfg.world_size; ++r) {
+        Message ready;
+        if (!ranks[static_cast<std::size_t>(r)].report_nccl_ready(true, 0, "", &ready, &error)) {
+            result.error = error;
+            return result;
+        }
+        Message m;
+        if (!wire(ready, &m, &error)) {
+            result.error = error;
+            return result;
+        }
+        if (!coordinator.accept(peer_of(r), m, &out, &error)) {
+            result.error = error;
+            return result;
+        }
+    }
+    // Deliver BeginLoad
+    for (const Message& control : out) {
+        Message m;
+        if (!wire(control, &m, &error)) {
+            result.error = error;
+            return result;
+        }
+        if (!ranks[static_cast<std::size_t>(m.rank)].accept_control(m, nullptr, &error)) {
+            result.error = error;
+            return result;
+        }
+    }
+
+    out.clear();
+    for (int r = 0; r < cfg.world_size; ++r) {
+        Message ready;
+        if (!ranks[static_cast<std::size_t>(r)].report_load_ready(true, 0, "", &ready, &error)) {
+            result.error = error;
+            return result;
+        }
+        Message m;
+        if (!wire(ready, &m, &error)) {
+            result.error = error;
+            return result;
+        }
+        if (!coordinator.accept(peer_of(r), m, &out, &error)) {
+            result.error = error;
+            return result;
+        }
+    }
+    if (coordinator.state() != CoordinatorState::Ready) {
+        result.error = "expected Ready after LoadReady";
+        return result;
+    }
+
+    result.tokens_seen_per_rank.assign(static_cast<std::size_t>(cfg.world_size), {});
+    for (int tok : cfg.tokens) {
+        out.clear();
+        if (!coordinator.begin_step(tok, &out, &error)) {
+            result.error = error;
+            return result;
+        }
+        // Deliver Token to every rank
+        for (const Message& control : out) {
+            Message m;
+            if (!wire(control, &m, &error)) {
+                result.error = error;
+                return result;
+            }
+            int got = -1;
+            if (!ranks[static_cast<std::size_t>(m.rank)].accept_control(m, &got, &error)) {
+                result.error = error;
+                return result;
+            }
+            if (got != tok) {
+                result.error = "token mismatch at rank";
+                return result;
+            }
+            result.tokens_seen_per_rank[static_cast<std::size_t>(m.rank)].push_back(got);
+        }
+        out.clear();
+        for (int r = 0; r < cfg.world_size; ++r) {
+            Message done;
+            if (!ranks[static_cast<std::size_t>(r)].report_step_done(true, 0, "", &done, &error)) {
+                result.error = error;
+                return result;
+            }
+            Message m;
+            if (!wire(done, &m, &error)) {
+                result.error = error;
+                return result;
+            }
+            if (!coordinator.accept(peer_of(r), m, &out, &error)) {
+                result.error = error;
+                return result;
+            }
+        }
+        if (coordinator.state() != CoordinatorState::Ready) {
+            result.error = "expected Ready after StepDone";
+            return result;
+        }
+    }
+
+    out.clear();
+    if (!coordinator.finish(&out, &error)) {
+        result.error = error;
+        return result;
+    }
+    for (const Message& control : out) {
+        Message m;
+        if (!wire(control, &m, &error)) {
+            result.error = error;
+            return result;
+        }
+        if (!ranks[static_cast<std::size_t>(m.rank)].accept_control(m, nullptr, &error)) {
+            result.error = error;
+            return result;
+        }
+    }
+    out.clear();
+    for (int r = 0; r < cfg.world_size; ++r) {
+        Message ack;
+        if (!ranks[static_cast<std::size_t>(r)].report_finish_ack(&ack, &error)) {
+            result.error = error;
+            return result;
+        }
+        Message m;
+        if (!wire(ack, &m, &error)) {
+            result.error = error;
+            return result;
+        }
+        if (!coordinator.accept(peer_of(r), m, &out, &error)) {
+            result.error = error;
+            return result;
+        }
+    }
+    if (coordinator.state() != CoordinatorState::Finished) {
+        result.error = "expected Finished";
+        return result;
+    }
+
+    for (int r = 0; r < cfg.world_size; ++r) {
+        if (result.tokens_seen_per_rank[static_cast<std::size_t>(r)] != cfg.tokens) {
+            result.error = "token sequence mismatch";
+            return result;
+        }
+    }
+    result.final_coord_state = coordinator.state();
+    result.ok = true;
+    return result;
+}
+
+}  // namespace dist
+}  // namespace tp
+}  // namespace sparkinfer
