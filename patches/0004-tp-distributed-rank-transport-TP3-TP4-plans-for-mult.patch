diff --git a/runtime/tests/tp_dist_rank_cpu_test.cpp b/runtime/tests/tp_dist_rank_cpu_test.cpp
new file mode 100644
index 0000000..c3e7325
--- /dev/null
+++ b/runtime/tests/tp_dist_rank_cpu_test.cpp
@@ -0,0 +1,211 @@
+// CPU tests: TP3/TP4 plan validation, in-process multi-rank protocol dry-run,
+// host-mock rank collective, and TCP framed socket round-trip.
+
+#include "sparkinfer/tp/rank_collective.h"
+#include "sparkinfer/tp/rank_protocol.h"
+#include "sparkinfer/tp/rank_transport.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <sys/socket.h>
+#include <thread>
+#include <vector>
+
+using namespace sparkinfer::tp;
+using namespace sparkinfer::tp::dist;
+
+static int g_checks = 0;
+static int g_failures = 0;
+
+#define CHECK(cond, ...)                                                          \
+    do {                                                                          \
+        ++g_checks;                                                               \
+        if (!(cond)) {                                                            \
+            ++g_failures;                                                          \
+            std::printf("FAIL %s:%d: ", __FILE__, __LINE__);                       \
+            std::printf(__VA_ARGS__);                                             \
+            std::printf("\n");                                                    \
+        }                                                                         \
+    } while (0)
+
+#define CHECK_EQ(a, b) CHECK((long long)(a) == (long long)(b),                    \
+                             "got %lld want %lld",                                \
+                             (long long)(a), (long long)(b))
+
+static void test_tp3_geometry() {
+    LocalhostDryRunConfig cfg;
+    cfg.world_size = 3;
+    cfg.tokens = {7, 8, 9};
+    auto r = run_localhost_protocol_dry_run(cfg);
+    CHECK(r.ok, "TP3 dry-run failed: %s", r.error.c_str());
+    CHECK_EQ(static_cast<int>(r.final_coord_state), static_cast<int>(CoordinatorState::Finished));
+}
+
+static void test_tp4_geometry() {
+    LocalhostDryRunConfig cfg;
+    cfg.world_size = 4;
+    cfg.tokens = {11, 12};
+    auto r = run_localhost_protocol_dry_run(cfg);
+    CHECK(r.ok, "TP4 dry-run failed: %s", r.error.c_str());
+    CHECK_EQ(static_cast<int>(r.final_coord_state), static_cast<int>(CoordinatorState::Finished));
+}
+
+static void test_reject_world_5() {
+    RankSpec s;
+    s.session_id = 1;
+    s.world_size = 5;
+    s.rank = 0;
+    s.vocab = 163840;
+    s.model_digest[0] = 1;
+    s.plan_digest[0] = 2;
+    ShardDims d;
+    const ShardError e = validate_rank_spec(s, &d);
+    CHECK(!e.ok(), "world 5 should be rejected");
+}
+
+static void test_host_mock_allreduce_tp3() {
+    const std::string key = "mock-tp3-ar";
+    std::vector<std::thread> threads;
+    std::atomic<int> ok{0};
+    for (int r = 0; r < 3; ++r) {
+        threads.emplace_back([&, r] {
+            std::string err;
+            auto coll = make_host_mock_rank_collective(3, r, key, &err);
+            if (!coll) return;
+            float v = static_cast<float>(r + 1);  // 1,2,3
+            if (!coll->allreduce_f32(&v, 1, 0)) return;
+            if (v == 6.f) ok.fetch_add(1);
+        });
+    }
+    for (auto& t : threads) t.join();
+    CHECK_EQ(ok.load(), 3);
+}
+
+static void test_host_mock_allreduce_tp4() {
+    const std::string key = "mock-tp4-ar";
+    std::vector<std::thread> threads;
+    std::atomic<int> ok{0};
+    for (int r = 0; r < 4; ++r) {
+        threads.emplace_back([&, r] {
+            std::string err;
+            auto coll = make_host_mock_rank_collective(4, r, key, &err);
+            if (!coll) return;
+            float buf[2] = {1.f, static_cast<float>(r)};
+            if (!coll->allreduce_f32(buf, 2, 0)) return;
+            if (buf[0] == 4.f && buf[1] == 6.f) ok.fetch_add(1);  // 0+1+2+3=6
+        });
+    }
+    for (auto& t : threads) t.join();
+    CHECK_EQ(ok.load(), 4);
+}
+
+static void test_tcp_framed_roundtrip() {
+    std::string err;
+    TcpListener listener;
+    CHECK(listener.listen("127.0.0.1", 0, &err), "listen failed: %s", err.c_str());
+    const uint16_t port = listener.bound_port();
+    CHECK(port != 0, "ephemeral port");
+
+    Message sent;
+    sent.type = MessageType::Token;
+    sent.session_id = 0xdeadbeefULL;
+    sent.sequence = 42;
+    sent.rank = 1;
+    sent.world_size = 3;
+    sent.local_device = 0;
+    sent.n_experts = 896;
+    sent.moe_ffn = 1536;
+    sent.expert_block_elems = 256;
+    sent.vocab = 163840;
+    sent.token_id = 17374;
+    sent.phase = Phase::Step;
+    sent.model_digest[0] = 9;
+    sent.plan_digest[0] = 8;
+    sent.detail = "tcp-roundtrip";
+
+    Message received;
+    std::atomic<bool> server_ok{false};
+    std::string server_err;
+    std::thread server([&] {
+        FramedSocket sock;
+        std::string peer;
+        if (!listener.accept(&sock, std::chrono::milliseconds(2000), &peer, &server_err)) return;
+        if (!sock.recv_message(&received, &server_err)) return;
+        // Echo FinishAck-shaped reply
+        Message reply = received;
+        reply.type = MessageType::StepDone;
+        reply.token_id = -1;
+        if (!sock.send_message(reply, &server_err)) return;
+        server_ok = true;
+    });
+
+    FramedSocket client;
+    CHECK(tcp_connect("127.0.0.1", port, std::chrono::milliseconds(2000), &client, &err),
+          "connect failed: %s", err.c_str());
+    CHECK(client.send_message(sent, &err), "send failed: %s", err.c_str());
+    Message echo;
+    CHECK(client.recv_message(&echo, &err), "recv failed: %s", err.c_str());
+    server.join();
+    CHECK(server_ok.load(), "server side failed: %s", server_err.c_str());
+    CHECK_EQ(received.token_id, 17374);
+    CHECK_EQ(received.sequence, 42);
+    CHECK(received.detail == "tcp-roundtrip", "detail mismatch");
+    CHECK(echo.type == MessageType::StepDone, "echo type");
+}
+
+static void test_tcp_rejects_oversize_payload_declaration() {
+    // Craft a bad header with payload_len = 600 (>506) and ensure recv fails
+    // before reading a body.
+    std::string err;
+    TcpListener listener;
+    CHECK(listener.listen("127.0.0.1", 0, &err), "listen: %s", err.c_str());
+    const uint16_t port = listener.bound_port();
+
+    std::atomic<bool> rejected{false};
+    std::thread server([&] {
+        FramedSocket sock;
+        std::string peer, e2;
+        if (!listener.accept(&sock, std::chrono::milliseconds(2000), &peer, &e2)) return;
+        Message m;
+        if (!sock.recv_message(&m, &e2)) {
+            if (e2.find("250..506") != std::string::npos ||
+                e2.find("outside") != std::string::npos) {
+                rejected = true;
+            }
+        }
+    });
+
+    FramedSocket client;
+    CHECK(tcp_connect("127.0.0.1", port, std::chrono::milliseconds(2000), &client, &err),
+          "connect: %s", err.c_str());
+    // Build illegal 16-byte header: magic K3RP, ver=1, type=Token, payload=600, crc=0
+    std::uint8_t hdr[16] = {};
+    hdr[0] = 'K'; hdr[1] = '3'; hdr[2] = 'R'; hdr[3] = 'P';
+    hdr[4] = 1; hdr[5] = 0;  // version
+    hdr[6] = 6; hdr[7] = 0;  // Token
+    const std::uint32_t bad_len = 600;
+    std::memcpy(hdr + 8, &bad_len, 4);
+    // send raw
+    const int fd = client.fd();
+    CHECK(fd >= 0, "fd");
+    // Use send via a small helper — FramedSocket doesn't expose raw send; use ::send
+    ssize_t w = ::send(fd, hdr, sizeof(hdr), 0);
+    CHECK(w == 16, "raw header send");
+    server.join();
+    CHECK(rejected.load(), "oversize payload must be rejected before body alloc");
+}
+
+int main() {
+    test_tp3_geometry();
+    test_tp4_geometry();
+    test_reject_world_5();
+    test_host_mock_allreduce_tp3();
+    test_host_mock_allreduce_tp4();
+    test_tcp_framed_roundtrip();
+    test_tcp_rejects_oversize_payload_declaration();
+
+    std::printf("tp_dist_rank_cpu_test: %d checks, %d failures\n", g_checks, g_failures);
+    return g_failures ? 1 : 0;
+}
