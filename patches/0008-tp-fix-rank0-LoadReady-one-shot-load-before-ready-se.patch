 .../include/sparkinfer/tp/rank_transport.h    |  11 +-
 runtime/src/tp/rank_transport_tcp.cpp         | 141 +++++++++++-------
 .../tp_dist_generate_protocol_cpu_test.cpp    |  89 +++++++++++
 4 files changed, 202 insertions(+), 61 deletions(-)
 mode change 100755 => 100644 runtime/examples/kimi_k3_dist_generate.cpp
 mode change 100755 => 100644 runtime/tests/tp_dist_generate_protocol_cpu_test.cpp

