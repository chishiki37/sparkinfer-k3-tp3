+++ b/runtime/include/sparkinfer/tp/rank_protocol.h
@@ -0,0 +1,244 @@
+#pragma once
+// CPU-only control-plane contract for one K3 TP rank per physical host.
+//
+// This file deliberately contains no sockets, CUDA, or NCCL. It defines the wire
+// frames and the coordinator/rank state machines that a transport adapter must drive.
+// Keeping the protocol independent makes ordering, replay rejection, rank-local
+// loading, token synchronization, and sticky failure propagation testable before a
+// collective can strand three expensive hosts in different phases.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "sparkinfer/tp/shard.h"
+
+namespace sparkinfer {
+namespace tp {
+namespace dist {
+
+constexpr std::uint16_t kProtocolVersion = 1;
+constexpr int kK3Tp3WorldSize = 3;
+constexpr int kNcclUniqueIdBytes = 128;
+constexpr std::size_t kDigestBytes = 32;
+constexpr std::size_t kMaxDetailBytes = 256;
+constexpr std::size_t kWireHeaderBytes = 16;
+constexpr std::size_t kWireFixedPayloadBytes = 250;
+constexpr std::size_t kMaxPayloadBytes = kWireFixedPayloadBytes + kMaxDetailBytes;
+constexpr std::size_t kMaxFrameBytes = kWireHeaderBytes + kMaxPayloadBytes;
+
+using Digest = std::array<std::uint8_t, kDigestBytes>;
+using NcclUniqueId = std::array<std::uint8_t, kNcclUniqueIdBytes>;
+
+enum class MessageType : std::uint16_t {
+    Hello = 1,
+    NcclUniqueId = 2,
+    NcclReady = 3,
+    BeginLoad = 4,
+    LoadReady = 5,
+    Token = 6,
+    StepDone = 7,
+    Failure = 8,
+    Abort = 9,
+    Finish = 10,
+    FinishAck = 11,
+};
+
+enum class Phase : std::uint16_t {
+    None = 0,
+    Bootstrap = 1,
+    NcclInit = 2,
+    Load = 3,
+    Step = 4,
+    Shutdown = 5,
+};
+
+// One process owns one local device. All three DGX Sparks may therefore use local
+// CUDA ordinal 0 while retaining distinct GLOBAL ranks 0/1/2.
+struct RankSpec {
+    std::uint64_t session_id = 0;
+    int world_size = kK3Tp3WorldSize;
+    int rank = 0;
+    int local_device = 0;
+    int n_experts = 896;
+    int moe_ffn = 1536;
+    int expert_block_elems = 256;
+    int vocab = 0;
+    Digest model_digest{};
+    Digest plan_digest{};
+};
+
+// Validates the exact three-Spark target and returns this rank's all-expert width
+// plan. The returned descriptor always has expert_band=[0,896) and a 512-wide FFN
+// band on the rank's correct third.
+ShardError validate_rank_spec(const RankSpec& spec, ShardDims* out);
+
+// Fixed-schema message. Every frame carries the cluster identity, so a delayed
+// packet from a prior session or another model cannot be mistaken for progress.
+struct Message {
+    MessageType type = MessageType::Hello;
+    std::uint64_t session_id = 0;
+    std::uint64_t sequence = 0;
+    int rank = -1;               // sender for replies; target for coordinator controls
+    int world_size = 0;
+    int local_device = 0;
+    int n_experts = 0;
+    int moe_ffn = 0;
+    int expert_block_elems = 0;
+    int vocab = 0;
+    int token_id = -1;
+    int status = 0;
+    Phase phase = Phase::None;
+    Digest model_digest{};
+    Digest plan_digest{};
+    NcclUniqueId nccl_id{};
+    std::string detail;
+};
+
+// Out-of-band identity supplied by the transport after it has authenticated or
+// statically configured a connection. connection_id is a nonzero, process-local
+// handle that stays stable for that socket/TLS session; it is never serialized.
+struct AuthenticatedPeer {
+    int rank = -1;
+    std::uint64_t connection_id = 0;
+};
+
+// Explicit little-endian framing with CRC32. Decode rejects unknown versions/types,
+// length mismatches, corrupt payloads, and oversized diagnostic strings.
+bool encode_message(const Message& message, std::vector<std::uint8_t>* frame,
+                    std::string* error = nullptr);
+bool decode_message(const std::uint8_t* frame, std::size_t size, Message* message,
+                    std::string* error = nullptr);
+
+enum class CoordinatorState {
+    CollectingHello,
+    AwaitingNcclUniqueId,
+    WaitingNcclReady,
+    WaitingLoadReady,
+    Ready,
+    StepInFlight,
+    WaitingFinishAck,
+    Finished,
+    Failed,
+};
+
+// Rank 0's control-plane state machine. It never creates an NCCL id itself: the
+// future NCCL adapter calls ncclGetUniqueId, copies the opaque 128 bytes, then calls
+// install_nccl_unique_id().
+class Coordinator {
+public:
+    explicit Coordinator(const RankSpec& cluster);
+
+    CoordinatorState state() const { return state_; }
+    bool good() const { return state_ != CoordinatorState::Failed; }
+    std::uint64_t next_sequence() const { return next_sequence_; }
+    const std::string& failure() const { return failure_; }
+
+    // Accept a rank-to-coordinator message from a transport-authenticated peer.
+    // peer comes from the connection binding, never from the in-band Message::rank
+    // field. A rank is bound to its first valid Hello connection; a second live
+    // connection cannot impersonate it. Outbound messages are appended, never
+    // silently discarded. Any protocol violation fails the cluster and appends one
+    // Abort per rank.
+    bool accept(const AuthenticatedPeer& peer, const Message& message,
+                std::vector<Message>* outbound,
+                std::string* error = nullptr);
+
+    bool install_nccl_unique_id(const NcclUniqueId& id,
+                                std::vector<Message>* outbound,
+                                std::string* error = nullptr);
+
+    // Broadcast one input token. A second token cannot start until every rank has
+    // acknowledged StepDone for the current sequence.
+    bool begin_step(int token_id, std::vector<Message>* outbound,
+                    std::string* error = nullptr);
+
+    // Clean EOS. Finish is sequence-gated and acknowledged by every rank; Finished
+    // is distinct from Failed so a normal generator shutdown is never reported as
+    // an abort.
+    bool finish(std::vector<Message>* outbound, std::string* error = nullptr);
+
+    // Transport timeout/local coordinator failure. Failure is sticky.
+    bool fail(Phase phase, int status, const std::string& detail,
+              std::vector<Message>* outbound, std::string* error = nullptr);
+
+private:
+    RankSpec cluster_;
+    CoordinatorState state_ = CoordinatorState::CollectingHello;
+    std::vector<unsigned char> hello_;
+    std::vector<unsigned char> nccl_ready_;
+    std::vector<unsigned char> load_ready_;
+    std::vector<unsigned char> step_done_;
+    std::vector<unsigned char> finish_ack_;
+    std::vector<std::uint64_t> peer_connection_;
+    std::uint64_t next_sequence_ = 0;
+    std::string failure_;
+
+    bool matches_cluster(const Message& message, std::string* why) const;
+    Message control(MessageType type, int target) const;
+    bool abort_cluster(Phase phase, int status, const std::string& detail,
+                       std::vector<Message>* outbound, std::string* error);
+};
+
+enum class RankState {
+    Created,
+    HelloSent,
+    NeedNcclInit,
+    NcclReadySent,
+    Loading,
+    WaitingToken,
+    StepRunning,
+    FinishPending,
+    Finished,
+    Failed,
+};
+
+// One worker process's state machine. Actual NCCL init and GGUF loading happen
+// between these calls; the state gates their ordering and produces acknowledgements.
+class RankSession {
+public:
+    explicit RankSession(const RankSpec& spec);
+
+    RankState state() const { return state_; }
+    bool good() const { return state_ != RankState::Failed; }
+    std::uint64_t next_sequence() const { return next_sequence_; }
+    const NcclUniqueId& nccl_unique_id() const { return nccl_id_; }
+    const std::string& failure() const { return failure_; }
+
+    bool hello(Message* outbound, std::string* error = nullptr);
+
+    // Accept NcclUniqueId, BeginLoad, Token, Finish, or Abort. For Token, token_id
+    // receives the synchronized input. No later sequence is accepted before StepDone.
+    bool accept_control(const Message& message, int* token_id = nullptr,
+                        std::string* error = nullptr);
+
+    bool report_nccl_ready(bool success, int status, const std::string& detail,
+                           Message* outbound, std::string* error = nullptr);
+    bool report_load_ready(bool success, int status, const std::string& detail,
+                           Message* outbound, std::string* error = nullptr);
+    bool report_step_done(bool success, int status, const std::string& detail,
+                          Message* outbound, std::string* error = nullptr);
+    bool report_finish_ack(Message* outbound, std::string* error = nullptr);
+
+    // Serialize the sticky local failure after accept_control()/a transport check
+    // rejected input. This gives the coordinator an immediate Failure instead of
+    // waiting for its phase timeout to discover that the rank stopped.
+    bool failure_message(Phase phase, int status, Message* outbound,
+                         std::string* error = nullptr) const;
+
+private:
+    RankSpec spec_;
+    RankState state_ = RankState::Created;
+    std::uint64_t next_sequence_ = 0;
+    NcclUniqueId nccl_id_{};
+    std::string failure_;
+
+    Message reply(MessageType type, Phase phase) const;
+    bool reject(const std::string& detail, std::string* error);
+};
+
+}  // namespace dist
+}  // namespace tp
+}  // namespace sparkinfer
