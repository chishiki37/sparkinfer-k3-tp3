+    RankSession empty_detail(spec_for(0));
+    Message bootstrap;
+    CHECK(empty_detail.hello(&bootstrap, &error), "empty-detail Hello");
+    bootstrap.type = MessageType::NcclUniqueId;
+    bootstrap.phase = Phase::NcclInit;
+    bootstrap.nccl_id[0] = 1;
+    CHECK(empty_detail.accept_control(bootstrap, nullptr, &error),
+          "empty-detail rank accepts valid NCCL id");
+    Message empty_failure;
+    CHECK(empty_detail.report_nccl_ready(false, 91, "", &empty_failure, &error),
+          "empty detail must still produce Failure");
+    CHECK(!empty_detail.failure().empty() && !empty_failure.detail.empty(),
+          "failed rank must retain a retryable fallback detail");
+    CHECK(empty_detail.failure_message(Phase::NcclInit, 91, &empty_failure, &error),
+          "fallback failure must remain serializable");
+
+    Harness discarded_token;
+    CHECK(discarded_token.bring_ready(), "discarded-token harness ready");
+    controls.clear();
+    CHECK(discarded_token.coordinator.begin_step(17, &controls, &error),
+          "begin discarded-token step");
+    CHECK(!discarded_token.ranks[0].accept_control(controls[0], nullptr, &error) &&
+              error.find("output sink") != std::string::npos,
+          "Token must not advance when its value would be discarded");
+    CHECK(discarded_token.ranks[0].state() == RankState::Failed,
+          "discarded Token must fail the rank");
+
+    Harness failed;
+    CHECK(failed.bring_ready(), "failure harness ready");
+    controls.clear();
+    CHECK(failed.coordinator.begin_step(8, &controls, &error), "begin failure step");
+    for (const Message& control : controls) {
+        int got = -1;
+        CHECK(failed.ranks[control.rank].accept_control(control, &got, &error),
+              "route token rank %d", control.rank);
+    }
+    Message failure;
+    CHECK(failed.ranks[1].report_step_done(false, 77, "rank 1 kernel failure",
+                                           &failure, &error),
+          "rank failure report");
+    std::vector<Message> aborts;
+    CHECK(!failed.coordinator.accept(peer_for(failure.rank), wire(failure),
+                                     &aborts, &error),
+          "rank Failure must abort coordinator");
+    CHECK(failed.coordinator.state() == CoordinatorState::Failed,
+          "coordinator failure not sticky");
+    CHECK_EQ(aborts.size(), 3);
+    for (const Message& abort : aborts) {
+        CHECK(abort.type == MessageType::Abort, "failure propagation is not Abort");
+        CHECK(failed.ranks[abort.rank].accept_control(wire(abort), nullptr, &error),
+              "rank %d did not consume Abort", abort.rank);
+    }
+    CHECK(failed.ranks[1].failure() == "rank 1 kernel failure",
+          "coordinator Abort overwrote the rank's more specific local failure");
+    controls.clear();
+    CHECK(!failed.coordinator.begin_step(9, &controls, &error),
+          "failed coordinator must reject later work");
+    CHECK(controls.empty(), "sticky failure should not emit a second abort storm");
+
+    Harness timeout;
+    CHECK(timeout.bring_ready(), "timeout harness ready");
+    aborts.clear();
+    CHECK(!timeout.coordinator.fail(Phase::Step, 408, "step timeout", &aborts, &error),
+          "timeout should return operational failure");
+    CHECK_EQ(aborts.size(), 3);
+    CHECK(timeout.coordinator.failure() == "step timeout", "timeout detail lost");
+
+    Harness missing_sink;
+    CHECK(missing_sink.bring_ready(), "missing-sink harness ready");
+    CHECK(!missing_sink.coordinator.fail(Phase::Step, 500, "local failure",
+                                         nullptr, &error),
+          "failure without outbound sink must fail closed");
+    CHECK(missing_sink.coordinator.state() == CoordinatorState::Ready &&
+              missing_sink.coordinator.failure().empty(),
+          "missing Abort sink must not strand peers by committing Failed");
+    aborts.clear();
+    CHECK(!missing_sink.coordinator.fail(Phase::Step, 500, "local failure",
+                                         &aborts, &error),
+          "failure propagation returns false after emitting Abort");
+    CHECK_EQ(aborts.size(), 3);
+}
+
+int main() {
+    test_rank_plan_is_exact();
+    test_wire_contract_and_corruption();
+    test_full_bootstrap_load_and_two_steps();
+    test_spec_and_bootstrap_refusals();
+    test_sequence_and_failure_propagation();
+    std::printf("%s: %d checks, %d failures\n",
+                g_failures ? "FAIL" : "PASS", g_checks, g_failures);
+    return g_failures ? 1 : 0;
+}
