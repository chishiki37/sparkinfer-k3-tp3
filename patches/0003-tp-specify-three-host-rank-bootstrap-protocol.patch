+    CHECK(!c.accept(peer_for(0), hello, &out, &error), "duplicate Hello must fail cluster");
+    CHECK(c.state() == CoordinatorState::Failed, "duplicate did not make failure sticky");
+    CHECK_EQ(out.size(), 3);
+    for (const Message& m : out) CHECK(m.type == MessageType::Abort, "expected Abort");
+
+    Coordinator duplicate_connection(spec_for(0));
+    RankSession connection_rank(spec_for(0));
+    CHECK(connection_rank.hello(&hello, &error), "connection-bound hello");
+    out.clear();
+    CHECK(duplicate_connection.accept(peer_for(0), hello, &out, &error),
+          "first rank connection must bind: %s", error.c_str());
+    CHECK(!duplicate_connection.accept(peer_for(0, 1), hello, &out, &error) &&
