+static void test_wire_contract_and_corruption() {
+    std::printf("wire_contract_and_corruption\n");
+    RankSession rank(spec_for(1));
+    Message hello;
+    std::string error;
+    CHECK(rank.hello(&hello, &error), "hello: %s", error.c_str());
+    hello.detail = "bounded diagnostic";
+    hello.status = -123;  // signed wire field must round-trip portably
+    const Message decoded = wire(hello);
+    CHECK(same_message(hello, decoded), "hello wire mismatch");
+
+    std::vector<std::uint8_t> bytes;
+    CHECK(encode_message(hello, &bytes, &error), "encode: %s", error.c_str());
+    CHECK_EQ(bytes.size(), kWireHeaderBytes + kWireFixedPayloadBytes + hello.detail.size());
+    Message out;
+
+    std::vector<std::uint8_t> corrupt = bytes;
+    corrupt.back() ^= 0x1;
+    CHECK(!decode_message(corrupt.data(), corrupt.size(), &out, &error) &&
+              error.find("CRC") != std::string::npos,
+          "payload corruption must fail CRC: %s", error.c_str());
+    CHECK(!decode_message(bytes.data(), bytes.size() - 1, &out, &error),
+          "truncated frame must fail");
+
+    corrupt = bytes;
+    corrupt[0] ^= 0xff;
+    CHECK(!decode_message(corrupt.data(), corrupt.size(), &out, &error) &&
+              error.find("magic") != std::string::npos,
+          "bad magic must fail");
+    corrupt = bytes;
+    corrupt[4] = 2; corrupt[5] = 0;
+    CHECK(!decode_message(corrupt.data(), corrupt.size(), &out, &error) &&
+              error.find("version") != std::string::npos,
+          "bad version must fail");
+    corrupt = bytes;
+    corrupt[6] = 99; corrupt[7] = 0;
+    CHECK(!decode_message(corrupt.data(), corrupt.size(), &out, &error) &&
+              error.find("type") != std::string::npos,
+          "bad type must fail");
+
+    // The declared size is rejected before a transport would allocate it or CRC
+    // over it. Bytes 8..11 are the little-endian payload length field.
+    corrupt = bytes;
+    corrupt[8] = 0xff; corrupt[9] = 0xff;
+    corrupt[10] = 0xff; corrupt[11] = 0x7f;
+    CHECK(!decode_message(corrupt.data(), corrupt.size(), &out, &error) &&
+              error.find("bounds") != std::string::npos,
+          "unbounded payload declaration must fail before CRC: %s", error.c_str());
+
+    hello.detail.assign(kMaxDetailBytes + 1, 'x');
+    CHECK(!encode_message(hello, &bytes, &error) && error.find("bound") != std::string::npos,
+          "oversized detail must fail");
+    hello.detail.assign(kMaxDetailBytes, 'x');
+    CHECK(encode_message(hello, &bytes, &error), "maximum-size frame must encode");
+    CHECK_EQ(bytes.size(), kMaxFrameBytes);
+}
