+static void test_rank_plan_is_exact() {
+    std::printf("rank_plan_is_exact\n");
+    int next = 0;
+    for (int rank = 0; rank < 3; ++rank) {
+        ShardDims d;
+        const ShardError e = validate_rank_spec(spec_for(rank), &d);
+        CHECK(e.ok(), "rank %d: %s", rank, e.message.c_str());
+        CHECK(d.moe_shard_mode == MoeShardMode::AllExpertsFfnWidth,
+              "rank %d wrong mode", rank);
+        CHECK_EQ(d.expert_band.offset, 0);
+        CHECK_EQ(d.expert_band.extent, 896);
+        CHECK_EQ(d.n_experts, 896);
+        CHECK_EQ(d.moe_ffn_band.offset, next);
+        CHECK_EQ(d.moe_ffn_band.extent, 512);
+        CHECK_EQ(d.moe_ffn_band.offset % 256, 0);
+        CHECK_EQ(d.moe_ffn_band.extent % 256, 0);
+        const TensorPlan gate = plan_for("blk.1.ffn_gate_exps.weight", 1536, 3584, d);
+        const TensorPlan up = plan_for("blk.1.ffn_up_exps.weight", 1536, 3584, d);
+        const TensorPlan down = plan_for("blk.1.ffn_down_exps.weight", 3584, 1536, d);
+        CHECK(gate.rule == Rule::ExpertRow2D && up.rule == Rule::ExpertRow2D,
+              "rank %d gate/up must split ne1", rank);
+        CHECK(down.rule == Rule::ExpertCol2D,
+              "rank %d down must split ne0", rank);
+        CHECK_EQ(gate.rows, 512);
+        CHECK_EQ(up.rows, 512);
+        CHECK_EQ(down.cols, 512);
+        CHECK_EQ(gate.experts.extent, 896);
+        CHECK_EQ(up.experts.extent, 896);
+        CHECK_EQ(down.experts.extent, 896);
+        next = d.moe_ffn_band.end();
+    }
+    CHECK_EQ(next, 1536);
+}
