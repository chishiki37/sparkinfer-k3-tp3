+// CPU-only distributed control-plane tests for one K3 TP rank per DGX Spark.
+
+#include "sparkinfer/tp/rank_protocol.h"
+#include "sparkinfer/tp/weight_plan.h"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+using namespace sparkinfer::tp;
+using namespace sparkinfer::tp::dist;
+
+static int g_checks = 0;
+static int g_failures = 0;
+
+#define CHECK(cond, ...)                                                          \
+    do {                                                                          \
+        ++g_checks;                                                               \
+        if (!(cond)) {                                                            \
+            ++g_failures;                                                         \
+            std::printf("FAIL %s:%d: ", __FILE__, __LINE__);                    \
+            std::printf(__VA_ARGS__);                                             \
+            std::printf("\n");                                                   \
+        }                                                                         \
+    } while (0)
+
+#define CHECK_EQ(a, b) CHECK((long long)(a) == (long long)(b),                    \
+                             "got %lld want %lld",                               \
+                             (long long)(a), (long long)(b))
+
+static RankSpec spec_for(int rank) {
+    RankSpec s;
+    s.session_id = 0x1122334455667788ULL;
+    s.rank = rank;
+    s.vocab = 163840;
+    for (std::size_t i = 0; i < s.model_digest.size(); ++i) {
+        s.model_digest[i] = static_cast<std::uint8_t>(i + 1);
+        s.plan_digest[i] = static_cast<std::uint8_t>(0xf0U - i);
+    }
+    return s;
+}
+
+static AuthenticatedPeer peer_for(int rank, std::uint64_t generation = 0) {
+    AuthenticatedPeer peer;
+    peer.rank = rank;
+    peer.connection_id = 0xc0010000ULL +
+                         static_cast<std::uint64_t>(rank) + generation * 16ULL;
+    return peer;
+}
+
+static bool same_message(const Message& a, const Message& b) {
+    return a.type == b.type && a.session_id == b.session_id &&
+           a.sequence == b.sequence && a.rank == b.rank &&
+           a.world_size == b.world_size && a.local_device == b.local_device &&
+           a.n_experts == b.n_experts && a.moe_ffn == b.moe_ffn &&
+           a.expert_block_elems == b.expert_block_elems && a.vocab == b.vocab &&
+           a.token_id == b.token_id && a.status == b.status && a.phase == b.phase &&
+           a.model_digest == b.model_digest && a.plan_digest == b.plan_digest &&
+           a.nccl_id == b.nccl_id && a.detail == b.detail;
+}
+
+static Message wire(const Message& in) {
+    std::vector<std::uint8_t> bytes;
+    std::string error;
+    CHECK(encode_message(in, &bytes, &error), "encode failed: %s", error.c_str());
+    Message out;
+    CHECK(decode_message(bytes.data(), bytes.size(), &out, &error),
+          "decode failed: %s", error.c_str());
+    CHECK(same_message(in, out), "wire round trip changed message");
+    return out;
+}
+
+struct Harness {
+    RankSpec cluster;
+    Coordinator coordinator;
+    std::vector<RankSession> ranks;
+
+    Harness() : cluster(spec_for(0)), coordinator(cluster) {
+        for (int rank = 0; rank < 3; ++rank) ranks.emplace_back(spec_for(rank));
+    }
+
+    bool bring_ready() {
+        std::vector<Message> out;
+        std::string error;
+        for (int rank = 0; rank < 3; ++rank) {
+            Message hello;
+            if (!ranks[rank].hello(&hello, &error)) return false;
+            if (!coordinator.accept(peer_for(rank), wire(hello), &out, &error)) return false;
+        }
+        if (coordinator.state() != CoordinatorState::AwaitingNcclUniqueId) return false;
+
+        NcclUniqueId id{};
+        for (std::size_t i = 0; i < id.size(); ++i)
+            id[i] = static_cast<std::uint8_t>(i ^ 0xa5U);
+        if (!coordinator.install_nccl_unique_id(id, &out, &error)) return false;
+        if (out.size() != 3) return false;
+        for (const Message& control : out) {
+            const Message m = wire(control);
+            if (!ranks[m.rank].accept_control(m, nullptr, &error)) return false;
+            if (ranks[m.rank].nccl_unique_id() != id) return false;
+        }
+        out.clear();
+
+        for (int rank = 0; rank < 3; ++rank) {
+            Message ready;
+            if (!ranks[rank].report_nccl_ready(true, 0, "", &ready, &error)) return false;
+            if (!coordinator.accept(peer_for(rank), wire(ready), &out, &error)) return false;
+        }
+        if (out.size() != 3 || coordinator.state() != CoordinatorState::WaitingLoadReady)
+            return false;
+        for (const Message& control : out) {
+            const Message m = wire(control);
+            if (!ranks[m.rank].accept_control(m, nullptr, &error)) return false;
+        }
+        out.clear();
+
+        for (int rank = 0; rank < 3; ++rank) {
+            Message ready;
+            if (!ranks[rank].report_load_ready(true, 0, "", &ready, &error)) return false;
+            if (!coordinator.accept(peer_for(rank), wire(ready), &out, &error)) return false;
+        }
+        return coordinator.state() == CoordinatorState::Ready;
+    }
+};
