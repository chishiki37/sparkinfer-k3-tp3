+static void test_full_bootstrap_load_and_two_steps() {
+    std::printf("full_bootstrap_load_and_two_steps\n");
+    Harness h;
+    CHECK(h.bring_ready(), "three-rank bootstrap/load did not reach Ready");
+    CHECK(h.coordinator.state() == CoordinatorState::Ready, "coordinator not ready");
+    for (int rank = 0; rank < 3; ++rank)
+        CHECK(h.ranks[rank].state() == RankState::WaitingToken,
+              "rank %d not waiting for token", rank);
+
+    for (int step = 0; step < 2; ++step) {
+        std::vector<Message> controls;
+        std::string error;
+        const int want_token = 420 + step;
+        CHECK(h.coordinator.begin_step(want_token, &controls, &error),
+              "begin step %d: %s", step, error.c_str());
+        CHECK_EQ(controls.size(), 3);
+        CHECK(h.coordinator.state() == CoordinatorState::StepInFlight,
+              "step %d not in flight", step);
+
+        std::vector<Message> done;
+        for (const Message& control : controls) {
+            const Message m = wire(control);
+            int got = -1;
+            CHECK(h.ranks[m.rank].accept_control(m, &got, &error),
+                  "rank %d token: %s", m.rank, error.c_str());
+            CHECK_EQ(got, want_token);
+            Message reply;
+            CHECK(h.ranks[m.rank].report_step_done(true, 0, "", &reply, &error),
+                  "rank %d done: %s", m.rank, error.c_str());
+            done.push_back(wire(reply));
+        }
+        controls.clear();
+        for (const Message& reply : done)
+            CHECK(h.coordinator.accept(peer_for(reply.rank), reply, &controls, &error),
+                  "StepDone: %s", error.c_str());
+        CHECK(h.coordinator.state() == CoordinatorState::Ready,
+              "step %d did not complete", step);
+        CHECK_EQ(h.coordinator.next_sequence(), step + 1);
+        for (int rank = 0; rank < 3; ++rank)
+            CHECK_EQ(h.ranks[rank].next_sequence(), step + 1);
+    }
+
+    std::vector<Message> controls;
+    std::string error;
+    CHECK(h.coordinator.finish(&controls, &error), "Finish: %s", error.c_str());
+    CHECK_EQ(controls.size(), 3);
+    CHECK(h.coordinator.state() == CoordinatorState::WaitingFinishAck,
+          "coordinator did not wait for FinishAck");
+    std::vector<Message> acknowledgements;
+    for (const Message& control : controls) {
+        const Message m = wire(control);
+        CHECK(h.ranks[m.rank].accept_control(m, nullptr, &error),
+              "rank %d Finish: %s", m.rank, error.c_str());
+        CHECK(h.ranks[m.rank].state() == RankState::FinishPending,
+              "rank %d did not enter FinishPending", m.rank);
+        Message ack;
+        CHECK(h.ranks[m.rank].report_finish_ack(&ack, &error),
+              "rank %d FinishAck: %s", m.rank, error.c_str());
+        CHECK(h.ranks[m.rank].state() == RankState::Finished,
+              "rank %d did not finish", m.rank);
+        acknowledgements.push_back(wire(ack));
+    }
+    controls.clear();
+    for (const Message& ack : acknowledgements)
+        CHECK(h.coordinator.accept(peer_for(ack.rank), ack, &controls, &error),
+              "coordinator FinishAck: %s", error.c_str());
+    CHECK(h.coordinator.state() == CoordinatorState::Finished,
+          "coordinator did not finish cleanly");
+    CHECK(!h.coordinator.begin_step(999, &controls, &error),
+          "finished coordinator accepted another token");
+    CHECK(controls.empty(), "finished coordinator emitted unexpected controls");
+}
