diff --git a/runtime/tests/tp_rank_local_loader_cpu_test.cpp b/runtime/tests/tp_rank_local_loader_cpu_test.cpp
new file mode 100755
index 0000000..2195258
--- /dev/null
+++ b/runtime/tests/tp_rank_local_loader_cpu_test.cpp
@@ -0,0 +1,117 @@
+// CPU test: rank-local MoE residency budget for TP3 (and TP4 dry-run).
+// No CUDA. Proves ~1/3 of routed-expert bytes land on each TP3 rank under
+// AllExpertsFfnWidth with Neuron shapes (896 experts x 1536 ffn, IQ1_S).
+
+#include "sparkinfer/tp/rank_local_loader.h"
+#include "sparkinfer/tp/rank_protocol.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+using namespace sparkinfer::tp;
+using namespace sparkinfer::tp::dist;
+
+static int g_fail = 0;
+static int g_pass = 0;
+
+static void check(bool cond, const std::string& what) {
+    if (cond) {
+        ++g_pass;
+        return;
+    }
+    ++g_fail;
+    std::printf("FAIL: %s\n", what.c_str());
+}
+
+static void check_near(double v, double lo, double hi, const std::string& what) {
+    check(v >= lo && v <= hi, what + " (got " + std::to_string(v) + ")");
+}
+
+int main() {
+    std::size_t model_bytes = 0;
+    std::size_t sum_rank = 0;
+    for (int r = 0; r < 3; ++r) {
+        RankSpec spec;
+        spec.session_id = 1;
+        spec.world_size = 3;
+        spec.rank = r;
+        spec.local_device = 0;
+        spec.vocab = 163840;
+        spec.model_digest[0] = 0xA5;
+        spec.plan_digest[0] = 0x5A;
+        RankLocalBudget b;
+        ShardError e = plan_rank_local_moe_budget(spec, &b);
+        check(e.ok(), "plan rank " + std::to_string(r) + " ok");
+        if (!e.ok()) {
+            std::printf("  err: %s\n", e.message.c_str());
+            continue;
+        }
+        check(b.plan.dims.moe_shard_mode == MoeShardMode::AllExpertsFfnWidth,
+              "mode AllExpertsFfnWidth");
+        check(b.plan.dims.n_experts == 896, "all 896 experts");
+        check(b.plan.dims.moe_ffn == 512, "ffn local 512");
+        check(b.plan.dims.moe_ffn_band.offset == r * 512, "ffn band offset");
+        check(b.moe_report.tensors == 92 * 3, "92 layers x 3 tensors");
+        check(b.moe_report.failed == 0, "no residency failures");
+        check_near(b.moe_rank_frac, 0.32, 0.35, "moe_rank_frac ~ 1/3");
+        if (r == 0) {
+            model_bytes = b.estimated_moe_model_bytes;
+            check(b.plan.full_lm_head_on_rank0_only, "lm head rank0 only flag");
+            check(b.receipt.find("\"load_head\":true") != std::string::npos, "receipt head true");
+        } else {
+            check(b.estimated_moe_model_bytes == model_bytes, "model bytes stable");
+            check(b.receipt.find("\"load_head\":false") != std::string::npos, "receipt head false");
+        }
+        sum_rank += b.estimated_moe_rank_bytes;
+        std::printf("rank %d: moe_rank_bytes=%zu frac=%.4f geo=%s\n", r,
+                    b.estimated_moe_rank_bytes, b.moe_rank_frac, b.plan.geometry_line.c_str());
+    }
+    if (model_bytes > 0) {
+        const double cover = (double)sum_rank / (double)model_bytes;
+        check_near(cover, 0.99, 1.01, "sum of rank MoE bytes ~= model MoE bytes");
+        std::printf("coverage sum_rank/model = %.6f\n", cover);
+    }
+
+    {
+        auto d = k3_neuron_moe_layer_descs(1, 896, 1536, 3584, /*iq1_s=*/19);
+        check(d.size() == 3, "3 descs");
+        check(d[0].ne[0] == 3584 && d[0].ne[1] == 1536 && d[0].ne[2] == 896, "gate shape");
+        check(d[2].ne[0] == 1536 && d[2].ne[1] == 3584 && d[2].ne[2] == 896, "down shape");
+    }
+
+    {
+        RankSpec bad;
+        bad.session_id = 1;
+        bad.world_size = 5;
+        bad.rank = 0;
+        bad.vocab = 163840;
+        bad.model_digest[0] = 0xA5;
+        bad.plan_digest[0] = 0x5A;
+        RankLocalBudget b;
+        ShardError e = plan_rank_local_moe_budget(bad, &b);
+        check(!e.ok(), "world=5 rejected");
+    }
+
+    {
+        RankSpec spec;
+        spec.session_id = 1;
+        spec.world_size = 4;
+        spec.rank = 0;
+        spec.vocab = 163840;
+        spec.model_digest[0] = 0xA5;
+        spec.plan_digest[0] = 0x5A;
+        RankLocalBudget b;
+        ShardError e = plan_rank_local_moe_budget(spec, &b);
+        check(e.ok(), "TP4 budget ok");
+        if (e.ok()) {
+            check(b.plan.dims.moe_2d, "TP4 moe_2d");
+            check(b.moe_report.failed == 0, "TP4 residency ok");
+            std::printf("tp4 rank0 frac=%.4f\n", b.moe_rank_frac);
+        }
+    }
+
+    std::printf("tp_rank_local_loader_cpu_test: %d checks, %d failures\n", g_pass + g_fail,
+                g_fail);
+    return g_fail ? 1 : 0;
+}
