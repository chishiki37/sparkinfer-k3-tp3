+bool CoordinatorTransport::complete_local_step(bool success, int status,
+                                               const std::string& detail,
+                                               std::string* error) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (coord_.state() != CoordinatorState::StepInFlight) {
+        set_err(error, "complete_local_step: no step in flight");
+        return false;
+    }
+    Message m;
+    m.type = success ? MessageType::StepDone : MessageType::Failure;
+    m.session_id = cluster_.session_id;
+    m.sequence = coord_.next_sequence();
+    m.rank = 0;
+    m.world_size = cluster_.world_size;
+    m.local_device = cluster_.local_device;
+    m.n_experts = cluster_.n_experts;
+    m.moe_ffn = cluster_.moe_ffn;
+    m.expert_block_elems = cluster_.expert_block_elems;
+    m.vocab = cluster_.vocab;
+    m.model_digest = cluster_.model_digest;
+    m.plan_digest = cluster_.plan_digest;
+    m.phase = Phase::Step;
+    m.status = status;
+    m.detail = detail;
+    std::vector<Message> outbound;
+    AuthenticatedPeer ap{0, conn_ids_.empty() ? 1ULL : conn_ids_[0]};
+    if (!coord_.accept(ap, m, &outbound, error)) return false;
+    return dispatch_outbound(outbound, error);
+}
+
+bool CoordinatorTransport::complete_local_finish_ack(std::string* error) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (coord_.state() != CoordinatorState::WaitingFinishAck &&
+        coord_.state() != CoordinatorState::Finished) {
+        // finish() may still be collecting; allow inject when waiting
+        if (coord_.state() != CoordinatorState::WaitingFinishAck) {
+            set_err(error, "complete_local_finish_ack: not waiting for finish acks");
+            return false;
+        }
+    }
+    Message m;
+    m.type = MessageType::FinishAck;
+    m.session_id = cluster_.session_id;
+    m.sequence = coord_.next_sequence();
+    m.rank = 0;
+    m.world_size = cluster_.world_size;
+    m.local_device = cluster_.local_device;
+    m.n_experts = cluster_.n_experts;
+    m.moe_ffn = cluster_.moe_ffn;
+    m.expert_block_elems = cluster_.expert_block_elems;
+    m.vocab = cluster_.vocab;
+    m.model_digest = cluster_.model_digest;
+    m.plan_digest = cluster_.plan_digest;
+    m.phase = Phase::Shutdown;
+    m.status = 0;
+    std::vector<Message> outbound;
+    AuthenticatedPeer ap{0, conn_ids_.empty() ? 1ULL : conn_ids_[0]};
+    if (!coord_.accept(ap, m, &outbound, error)) return false;
+    return dispatch_outbound(outbound, error);
+}
