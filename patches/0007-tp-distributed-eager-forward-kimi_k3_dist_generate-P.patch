+// CPU test: Phase 3 control-plane hooks for distributed generate.
+// - localhost protocol dry run (existing)
+// - CoordinatorTransport complete_local_step sequencing (unit-level via dry run parity)
+// No CUDA / no GGUF.
+
+#include "sparkinfer/tp/rank_protocol.h"
+#include "sparkinfer/tp/rank_transport.h"
+
+#include <cstdio>
+#include <string>
+
+using namespace sparkinfer::tp::dist;
+
+static int g_fail = 0;
+static int g_pass = 0;
+
+static void check(bool c, const std::string& w) {
+    if (c) {
+        ++g_pass;
+        return;
+    }
+    ++g_fail;
+    std::printf("FAIL: %s\n", w.c_str());
+}
+
+int main() {
+    {
+        LocalhostDryRunConfig cfg;
+        cfg.world_size = 3;
+        cfg.tokens = {10, 20, 30};
+        cfg.session_id = 42;
+        cfg.vocab = 163840;
+        cfg.model_digest[0] = 1;
+        cfg.plan_digest[0] = 2;
+        auto r = run_localhost_protocol_dry_run(cfg);
+        check(r.ok, "localhost dry run tp3: " + r.error);
+        if (r.ok) {
+            check(r.tokens_seen_per_rank.size() == 3, "3 ranks saw tokens");
+            check(r.tokens_seen_per_rank[0].size() == 3, "rank0 3 tokens");
+            check(r.final_coord_state == CoordinatorState::Finished, "finished");
+        }
+    }
+    {
+        LocalhostDryRunConfig cfg;
+        cfg.world_size = 4;
+        cfg.tokens = {1, 2};
+        cfg.session_id = 7;
+        cfg.vocab = 163840;
+        cfg.model_digest[0] = 3;
+        cfg.plan_digest[0] = 4;
+        auto r = run_localhost_protocol_dry_run(cfg);
+        check(r.ok, "localhost dry run tp4: " + r.error);
+    }
+
+    // plan_identity_string stable
+    {
+        auto a = plan_identity_string(3);
+        auto b = plan_identity_string(3);
+        check(a == b && a.find("world=3") != std::string::npos, "plan identity");
+    }
+
+    std::printf("tp_dist_generate_protocol_cpu_test: %d checks, %d failures\n", g_pass + g_fail,
+                g_fail);
+    return g_fail ? 1 : 0;
+}
